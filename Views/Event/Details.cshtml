    string locName = Model?.Location ?? "No Location";
    string locDetail = "";

    if (!string.IsNullOrEmpty(Model?.Location))
    {
        int firstDigitIndex = Model.Location.IndexOfAny("0123456789".ToCharArray());
        if (firstDigitIndex > 0)
        {
            locName = Model.Location.Substring(0, firstDigitIndex).Trim(); 
            locDetail = Model.Location.Substring(firstDigitIndex).Trim(); 
        }
        else if (firstDigitIndex == 0)
        {
            locName = "Address";
            locDetail = Model.Location;
        }
    }
