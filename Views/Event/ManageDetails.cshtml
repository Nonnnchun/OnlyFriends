@model OnlyFriends.Models.DTOS.EventDTOS.GetEventDTO
@using OnlyFriends.Models.DTOS.EventDTOS

@{
    ViewData["Title"] = Model.Title?? "Manage Details";
}


@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/manage-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/invite-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/add-host-modal.css" asp-append-version="true" />
}

    @section Scripts {
      <script src="~/js/manage-details.js" asp-append-version="true"></script>
      <script src="~/js/invite-modal.js" asp-append-version="true"></script>
      <script src="~/js/add-host-modal.js" asp-append-version="true"></script>
}
  @Html.AntiForgeryToken()
  @await Html.PartialAsync("_InviteModal", Model)
  @await Html.PartialAsync("_AddHostModal", Model)
  
  <div class="app-body">
  
      @* ── MAIN ── *@
      <main class="main" id="mainContent">
      
          @* Breadcrumb *@
          <div class="breadcrumb">
              <a asp-controller="Calendar" asp-action="Index">@Model.Owner.FirstName @Model.Owner.LastName</a>
              <span>›</span>
          </div>
  
          @* Page Title *@
          <div class="page-title-row">
              <h1 class="page-title" id="displayTitle">@Model.Title</h1>
              <a asp-controller="Event" asp-action="View" asp-route-id="@Model.Id" class="btn-event-page" target="_blank">
                  <i class="fa-solid fa-arrow-up-right-from-square" style="font-size:12px"></i> Event Page
              </a>
          </div>
  
          @* Tabs *@
          <div class="tabs">
              <div class="tab active" onclick="switchTab(this)">Overview</div>
              <div class="tab" onclick="switchTab(this)">Guests</div>
              <div class="tab" onclick="switchTab(this)">Registration</div>
          </div>
  
          @* ══ TAB: OVERVIEW ══ *@
          <div id="tab-Overview">
  
              @* Event Preview + When & Where *@
              <div class="event-preview-wrap">
                  <div class="event-preview-inner">
                  
                      @* Left: Event Card *@
                      <div>
                          <div class="event-card">
                              <div class="event-card-cover">
                                  <img class="event-card-cover-emoji"src="@Model.PosterUrl" alt="event cover"></img>
                                  <button class="change-cover-btn" onclick="openPanel()">
                                      <i class="fa-solid fa-image"></i> Change
                                  </button>
                              </div>
                              <div class="event-card-body">
                                  <div class="event-card-title" id="cardTitle">@Model.Title</div>
                                  <div class="event-card-meta">
                                      <div class="event-card-meta-row">
                                          <i class="fa-regular fa-calendar"></i>
                                          <span id="cardDate">@Model.StartAt?.ToString("dd:MM:yyyy")</span>
                                      </div>
                                      <div class="event-card-meta-row">
                                          <i class="fa-regular fa-clock"></i>
                                          <span id="cardTime">
                                             @Model.StartAt?.ToString("h:mm tt") - @Model.EndAt?.ToString("h:mm tt")
                                          </span>
                                      </div>
                                      <div class="event-card-meta-row">
                                          <i class="fa-solid fa-location-dot"></i>
                                          <span>@(Model.Location?.Length > 35 ? Model.Location.Substring(0, 35) + "..." : Model.Location)</span>
                                      </div>
                                      <div class="event-card-meta-row">
                                          <i class="fa-solid fa-users"></i>
                                          <span id="cardCapacity">Capacity: @Model.Capacity </span>
                                      </div>
                                  </div>
                              </div>
                              <div class="event-card-footer">
                                  <div>
                                      <div class="event-card-footer-label">Registration</div>
                                      <span id="regStatus" class="@(Model.EventStatus == EnumEventStatus.Open ? "status-open" : "status-closed")">
                                          @(Model.EventStatus == EnumEventStatus.Open ? "Registration Open" : "Registration Closed")
                                      </span>
                                  </div>
                                  <button class="rsvp-btn">One-Click RSVP</button>
                              </div>
                              <div class="event-url-row">
                                  <span id="eventUrl">eventhub.com/URL ↗</span> 
                                  <button class="copy-btn" onclick="copyUrl()">COPY</button>
                              </div>
                          </div>
  
                           @* Share & Edit *@
                          <div class="share-row" style="margin-top:12px">
                              <span class="share-label">Share Event</span>
                              <div class="share-icons">
                                  <div class="share-icon-btn"><i class="fa-brands fa-facebook-f"></i></div>
                                  <div class="share-icon-btn"><i class="fa-brands fa-x-twitter"></i></div>
                                  <div class="share-icon-btn"><i class="fa-brands fa-linkedin-in"></i></div>
                                  <div class="share-icon-btn"><i class="fa-regular fa-comment-dots"></i></div>
                              </div>
                          </div>
                      </div>
  
                      @* Right: When & Where *@
                      <div class="when-where">
                          <h3>When &amp; Where</h3>
                          <div class="when-block">
                              <div class="date-badge">
                                  <div class="date-badge-month">@Model.StartAt?.ToString("MMM").ToUpper()</div>
                                  <div class="date-badge-day">@Model.StartAt?.Day</div>
                              </div>
                              <div>
                                  <div class="when-title">
                                      @(Model.StartAt?.Date == DateTime.Today ? "Today" : Model.StartAt?.ToString("dddd dd, MMMM "))
                                  </div>
                                  <div class="when-sub" id="whenTime">
                                      @Model.StartAt?.ToString("h:mm tt") - @Model.EndAt?.ToString("h:mm tt")
                                  </div>
                              </div>
                          </div>
                          <div class="location-block">
                              <div class="loc-icon-box">  
                                <svg class="loc-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
                                    <g fill="none" fill-rule="evenodd" stroke="currentColor" stroke-linecap="round"stroke-linejoin="round" stroke-width="1.5">
                                        <path d="M2 6.854C2 11.02 7.04 15 8 15s6-3.98 6-8.146C14 3.621 11.314 1 8 1S2 3.62 2 6.854"></path>
                                        <path d="M9.5 6.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"></path>
                                    </g>
                                </svg>
                              </div>
                              <div>
                                  <div class="loc-name">@(Model.Location?.Length > 30 ? Model.Location.Substring(0, 30) + "..." : Model.Location) ↗</div>
                                  <div class="loc-sub">@Model.Location</div>
                                  <div class="loc-note">The address is shown publicly on the event page.</div>
                              </div>
                          </div>
                          <button class="btn-checkin"><i class="fa-solid fa-qrcode"></i> Check In Guests</button>
                          <div class="edit-btns">
                          <button class="btn-outline" onclick="openPanel()">
                              <i class="fa-solid fa-pen"></i> Edit Event
                          </button>
                          <button class="btn-outline" onclick="toggleRegistration()">
                              <i class="fa-solid @(Model.EventStatus == EnumEventStatus.Open ? "fa-toggle-on" : "fa-toggle-off")" id="regToggleIcon"></i>
                              <span id="regToggleLabel">@(Model.EventStatus == EnumEventStatus.Open ? "Registration Closed" : "Registration Open")</span>
                          </button>
                      </div>
                      </div>
                  </div>
              </div>
  
              @* Stats *@
              <div class="stats-row">
                  <div class="stat-card highlight">
                      <div class="stat-value" id="statRegistered">@Model.UserEvents.Count(ue => ue.RequestStatus == EnumRequestStatus.Pending)</div>
                      <div class="stat-label">Total Applicants</div>
                  </div>
                  <div class="stat-card">
                      <div class="stat-value" id="statApproved">@Model.UserEvents.Count(ue => ue.RequestStatus == EnumRequestStatus.Accepted)</div>
                      <div class="stat-label">Selected</div>
                  </div>
                  <div class="stat-card">
                      <div class="stat-value" id="statCapacity">@Model.Capacity</div>
                      <div class="stat-label">Total Capacity</div>
                  </div>
              </div>
  
              @* Recent Registrants *@
              <div class="section">
                  <div class="section-header">
                      <div class="section-title">Participants</div>
                      <button class="btn-plus" onclick="switchTab(document.querySelectorAll('.tab')[1])">View All</button>
                  </div>
                  <div class="section-sub">Recent Applicants</div>
                  <div class="registrant-list">
                      @foreach (var reg in Model.Users)
                      {
                        <div class="registrant-item">
                            <img class="reg-avatar" src="@reg.ProfilePictureUrl" alt="@reg.Username.Substring(0,1).ToUpper()" />
                            <div style="flex:1;">
                                <div class="reg-name">
                                    @reg.FirstName @reg.LastName 
                                    <span class="reg-Email">@reg.Email</span>
                                </div>
                            </div>
                            <div class="reg-time" style="margin-left:auto; white-space:nowrap;">
                                <span class="reg-status">@{UserEvent? userEvent = Model.UserEvents.FirstOrDefault(u => u.UserId == reg.Id);}@userEvent?.RequestStatus</span>
                                @Model.UserEvents.FirstOrDefault(u => u.UserId == reg.Id)?.RegisteredAt.ToString("dd MMM yyyy ,HH:mm")
                            </div>
                        </div>
                      }
                  </div>
              </div>
  
              @* Invites *@
              <div class="section">
                  <div class="section-header">
                      <div class="section-title">Invites</div>
                      <button class="btn-plus" onclick="openInviteModal()"><i class="fa-solid fa-plus"></i>Invite Guests</button>
                  </div>
                  <div class="section-sub">Invite subscribers, contacts and past guests via email or SMS.</div>
                  <div class="empty-state">
                      <div class="empty-icon"><i class="fa-regular fa-envelope"></i></div>
                      <div>
                          <div class="empty-title">Invites Sent</div>
                          <div class="empty-sub">You can invite subscribers, contacts and past guests to the event.</div>
                      </div>
                  </div>
              </div>
  
              @* Hosts *@
              <div class="section">
                  <div class="section-header">
                      <div class="section-title">Hosts</div>
                      <button class="btn-plus" onclick="openAddHostModal()"><i class="fa-solid fa-plus"></i> Add Host</button>
                  </div>
                  <div style="margin-top:8px">
                      <div class="host-row">
                          <img class="host-avatar" src="@Model.Owner.ProfilePictureUrl" alt="@Model.Owner.Username.Substring(0,1).ToUpper()" />
                          <div>
                              <span class="host-name">@Model.Owner.Username</span>
                              <span class="host-email">@Model.Owner.Email</span>
                              <span class="badge-creator">Creator</span>
                          </div>
                      </div>
                  </div>
              </div>
          </div>
  
          @* ══ TAB: GUESTS ══ *@
          <div id="tab-Guests" style="display:none">
              <div class="section">
                  <div class="section-header">
                      <div class="section-title">Participants List</div>
                      <div style="display:flex;gap:8px">
                      </div>
                  </div>
                    <div class="search-input-wrap">
                      <input class="form-input" id="participantSearch" placeholder="Search...."oninput="filterParticipants(this.value)" />
                  </div> 
                        <div class="filter-tabs" style="display:flex;gap:8px;margin-bottom:16px">
                            <button class="filter-btn active" onclick="filterByStatus(this, '')">All</button>
                            <button class="filter-btn" onclick="filterByStatus(this, 'Accepted')">Accepted</button>
                            <button class="filter-btn" onclick="filterByStatus(this, 'Pending')">Pending</button>
                            <button class="filter-btn" onclick="filterByStatus(this, 'Rejected')">Rejected</button>
                        </div>
                        <div class="registrant-list" id="participantList">
                            @foreach (var reg in Model.Users)
                            {
                                <div class="registrant-item"
                                     data-name="@reg.FirstName @reg.LastName"
                                     data-email="@reg.Email"
                                     data-status="@{var userEvent = Model.UserEvents.FirstOrDefault(u => u.UserId == reg.Id);}@userEvent?.RequestStatus">
                                    <img class="reg-avatar"
                                         src="@reg.ProfilePictureUrl"
                                         alt="@reg.Username.Substring(0,1).ToUpper()"
                                         onerror="this.style.display='none'" />
                                    <div style="flex:1;">
                                        <div class="reg-name">
                                            @reg.FirstName @reg.LastName
                                            <span class="reg-Email">@reg.Email</span>
                                        </div>
                                    </div>
                                    <div class="reg-time" style="margin-left:auto; white-space:nowrap;">
                                        <span class="reg-status">@userEvent?.RequestStatus</span>
                                        @userEvent?.RegisteredAt.ToString("dd MMM yyyy ,HH:mm")

                                    </div>
                                </div>
                            }
                        </div>

                        <div id="participantEmpty" style="display:none" class="empty-state">
                            <div class="empty-icon"><i class="fa-regular fa-user"></i></div>
                            <div>
                                <div class="empty-title">No participants found</div>
                                <div class="empty-sub">Try searching with a different name or email</div>
                            </div>
                        </div>
              </div>
          </div>
  
          @* ══ TAB: REGISTRATION ══ *@
          <div id="tab-Registration" style="display:none">
              <div class="section">
                  <div class="section-title" style="margin-bottom:16px">การตั้งค่าการสมัคร</div>
                  <div class="toggle-row">
                      <div>
                          <div class="toggle-label">เปิดรับสมัคร</div>
                          <div class="toggle-sub">เปิด/ปิดการรับสมัครของกิจกรรมนี้</div>
                      </div>
                      <div class="toggle @(Model.EventStatus == EnumEventStatus.Open ? "on" : "")" id="regToggle2" onclick="toggleRegistration()"></div>
                  </div>
                  <div class="toggle-row">
                      <div>
                          <div class="toggle-label">รับสมัครเกินจำนวน (Waitlist)</div>
                          <div class="toggle-sub">ให้ผู้สมัครเพิ่มเติมรอในลิสต์สำรอง</div>
                      </div>
                      @* <div class="toggle @(Model.AllowWaitlist ? "on" : "")" onclick="this.classList.toggle('on')"></div> *@
                  </div>
                  <div class="toggle-row">
                      <div>
                          <div class="toggle-label">อนุมัติอัตโนมัติ</div>
                          <div class="toggle-sub">ระบบเลือกผู้ร่วมกิจกรรมอัตโนมัติตามเวลา</div>
                      </div>
                      @* <div class="toggle @(Model.AutoApprove ? "on" : "")" onclick="this.classList.toggle('on')"></div> *@
                  </div>
              </div>
          </div>
  
      </main>
  
      @* ══ EDIT PANEL ══ *@
      <aside class="edit-panel"
             id="editPanel"
             data-event-id="@Model.Id"
             data-reg-open="@Model.EventStatus == EnumEventStatus.Open.ToString().ToLower()">
  
          <div class="panel-header">
              <div class="panel-title">Edit Event</div>
              <button class="panel-close" onclick="closePanel()"><i class="fa-solid fa-xmark"></i></button>
          </div>
  
          <div class="panel-body">
          
              @* Basic Info *@
              <div class="form-group">
                  <label class="form-label">EVENT TITLE</label>
                  <input class="form-input" id="inputTitle" value="@Model.Title" oninput="previewTitle(this.value)" />
              </div>
  
              <div class="form-group">
                  <label class="form-label">DESCRIPTION</label>
                  <textarea class="form-textarea" id="inputDesc">@Model.Info</textarea>
              </div>
  
              <div class="form-group">
                  <label class="form-label">CATEGORY</label>
                  @* <select class="form-select" id="inputCategory"> *@
                      @* <option @(Model.Category == "กีฬา / หาทีม" ? "selected" : "")>กีฬา / หาทีม</option> *@
                      @* <option @(Model.Category == "อาหาร / บุฟเฟต์" ? "selected" : "")>อาหาร / บุฟเฟต์</option> *@
                      @* <option @(Model.Category == "ช็อปปิ้ง / ฝากซื้อ" ? "selected" : "")>ช็อปปิ้ง / ฝากซื้อ</option> *@
                      @* <option @(Model.Category == "ท่องเที่ยว" ? "selected" : "")>ท่องเที่ยว</option> *@
                      @* <option @(Model.Category == "อื่นๆ" ? "selected" : "")>อื่นๆ</option> *@
                  @* </select> *@
              </div>
  
              <hr class="divider">
  
              @* Time *@
              <div class="form-group">
                  <label class="form-label">DATE &amp; TIME</label>
                  <input class="form-input" type="date" id="inputDate"
                         value="@Model.StartAt?.ToString("yyyy-MM-dd")"
                         style="margin-bottom:8px"
                         oninput="previewDate(this.value)" />
                  <div class="time-row">
                      <input class="form-input" type="time" id="inputStart"
                             value="@Model.StartAt?.ToString("HH:mm")"
                             oninput="previewTime()" />
                      <span class="time-separator">→</span>
                      <input class="form-input" type="time" id="inputEnd"
                             value="@Model.EndAt?.ToString("HH:mm")"
                             oninput="previewTime()" />
                  </div>
              </div>
  
              <div class="form-group">
                  <label class="form-label">DEADLINE / หมดอายุ</label>
                  <input class="form-input" type="datetime-local" id="inputDeadline"
                         value="@(Model.EndAt.HasValue ? Model.EndAt.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
              </div>
  
              <hr class="divider">
  
              @* Location *@
              <div class="form-group">
                  <label class="form-label">LOCATION</label>
                  <input class="form-input" id="inputLocation" value="@Model.Location" />
              </div>
  
              <hr class="divider">
  
              @* Capacity *@
              <div class="form-group">
                  <label class="form-label">จำนวนที่รับ (CAPACITY)</label>
                  <div class="capacity-row">
                      <button class="capacity-adj" onclick="adjustCapacity(-1)">−</button>
                      <input class="form-input capacity-input" id="inputCapacity"
                             type="number" value="@Model.Capacity" min="1"
                             oninput="previewCapacity(this.value)" />
                      <button class="capacity-adj" onclick="adjustCapacity(1)">+</button>
                  </div>
              </div>
  
              <hr class="divider">
  
              @* Selection Method *@
              <div class="form-group">
                  <label class="form-label">วิธีคัดเลือก</label>
                  <div class="method-options">
                      @* <div class="method-option @(Model.SelectionMethod == "FCFS" ? "selected" : "")" onclick="selectMethod(this)">
                          <div class="method-radio"></div>
                          <div>
                              <div class="method-name">First-Come-First-Served</div>
                              <div class="method-desc">รับตามลำดับก่อน-หลัง จนครบจำนวน</div>
                          </div>
                      </div>
                      <div class="method-option @(Model.SelectionMethod == "Random" ? "selected" : "")" onclick="selectMethod(this)">
                          <div class="method-radio"></div>
                          <div>
                              <div class="method-name">สุ่มเลือก (Random)</div>
                              <div class="method-desc">สุ่มจากผู้สมัครทั้งหมดเมื่อครบกำหนด</div>
                          </div>
                      </div>
                      <div class="method-option @(Model.SelectionMethod == "Manual" ? "selected" : "")" onclick="selectMethod(this)">
                          <div class="method-radio"></div>
                          <div>
                              <div class="method-name">เจ้าของโพสต์เลือกเอง</div>
                              <div class="method-desc">เจ้าของตัดสินใจเลือกผู้เข้าร่วมเอง</div>
                          </div>
                      </div> *@
                  </div>
              </div>
  
              <hr class="divider">
  
              @* Options *@
              @* <div class="form-group">
                  <label class="form-label">OPTIONS</label>
                  <div class="toggle-row">
                      <div>
                          <div class="toggle-label">รับ Waitlist</div>
                          <div class="toggle-sub">รับสมัครเกินจำนวน เผื่อมีคนสละสิทธิ์</div>
                      </div>
                      <div class="toggle @(Model.AllowWaitlist ? "on" : "")" onclick="this.classList.toggle('on')"></div>
                  </div>
                  <div class="toggle-row">
                      <div>
                          <div class="toggle-label">แสดงรายชื่อผู้สมัคร</div>
                          <div class="toggle-sub">ให้ผู้อื่นเห็นว่าใครสมัครแล้ว</div>
                      </div>
                      <div class="toggle @(Model.ShowParticipants ? "on" : "")" onclick="this.classList.toggle('on')"></div>
                  </div>
              </div> *@
  
          </div>
  
          <div class="panel-footer">
              <button class="btn-update" onclick="updateEvent()">
                  <i class="fa-solid fa-floppy-disk"></i> Update Event
              </button>
          </div>
  
      </aside>
  
  </div>
  
  @* ── TOAST ── *@
  <div class="toast" id="toast">
      <i class="fa-solid fa-circle-check"></i>
      <span id="toastMsg">Saved!</span>
  </div>


