@model OnlyFriends.Models.DTOS.EventDTOS.GetEventDTO
@using OnlyFriends.Models.DTOS.EventDTOS

@{
    ViewData["Title"] = Model.Title?? "Manage Details";
}


@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/manage-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/invite-modal.css" asp-append-version="true" />
}

    @section Scripts {
      <script src="~/js/manage-details.js" asp-append-version="true"></script>
      <script src="~/js/invite-modal.js" asp-append-version="true"></script>
}
  @Html.AntiForgeryToken()
  @await Html.PartialAsync("_InviteModal", Model)

@{
    var eventPageUrl = Url.Action("View", "Event", new { id = Model.Id }, Context.Request.Scheme) ?? "";
    var defaultAvatar = "/images/avatar-placeholder.svg";
    var hostAvatarIsDefault = string.IsNullOrWhiteSpace(Model.Owner.ProfilePictureUrl);
    var hostAvatar = hostAvatarIsDefault ? defaultAvatar : Model.Owner.ProfilePictureUrl;
}
  
  <div class="app-body">
  
      @* ── MAIN ── *@
      <main class="main" id="mainContent">
      
          @* Breadcrumb *@
          <div class="breadcrumb">
              <a href="/user/@Model.Owner.Username" >@Model.Owner.FirstName @Model.Owner.LastName</a>
               <span>&rsaquo;</span>
          </div>
  
          @* Page Title *@
          <div class="page-title-row">
              <h1 class="page-title" id="displayTitle">@Model.Title</h1>
              <a asp-controller="Event" asp-action="View" asp-route-id="@Model.Id" class="btn-event-page" target="_blank">
                  <i class="fa-solid fa-arrow-up-right-from-square" style="font-size:12px"></i> Event Page
              </a>
          </div>
  
          @* Tabs *@
          <div class="tabs">
              <div class="tab active" onclick="switchTab(this)">Overview</div>
              <div class="tab" onclick="switchTab(this)">Guests</div>
              <div class="tab" onclick="switchTab(this)">Registration</div>
          </div>
  
          @* ══ TAB: OVERVIEW ══ *@
          <div id="tab-Overview">
  
              @* Event Preview + When & Where *@
              <div class="event-preview-wrap">
                  <div class="event-preview-inner">
                  
                      @* Left: Event Card *@
                      <div>
                          <div class="event-card">
                              <div class="event-card-cover">
                                  <img class="event-card-cover-emoji" id="eventCoverImage" src="@Model.PosterUrl" alt="event cover"></img>
                                  <button class="change-cover-btn" onclick="openCoverPicker()">
                                      <i class="fa-solid fa-image"></i> Change
                                  </button>
                                  <input type="file" id="coverFileInput" accept="image/*" hidden onchange="handleCoverFileChange(this)" />
                              </div>
                              <div class="event-card-body">
                                  <div class="event-card-title" id="cardTitle">@Model.Title</div>
                                  <div class="event-card-meta">
                                      <div class="event-card-meta-row">
                                          <i class="fa-regular fa-calendar"></i>
                                           <span id="cardDate">@Model.StartAt?.ToString("dddd, MMMM d")</span>
                                      </div>
                                      <div class="event-card-meta-row">
                                          <i class="fa-regular fa-clock"></i>
                                          <span id="cardTime">
                                             @Model.StartAt?.ToString("h:mm tt") - @Model.EndAt?.ToString("h:mm tt")
                                          </span>
                                      </div>
                                      <div class="event-card-meta-row">
                                          <i class="fa-solid fa-location-dot"></i>
                                          <span>@(Model.Location?.Length > 35 ? Model.Location.Substring(0, 35) + "..." : Model.Location)</span>
                                      </div>
                                      <div class="event-card-meta-row">
                                          <i class="fa-solid fa-users"></i>
                                          <span id="cardCapacity">Capacity: @Model.Capacity </span>
                                      </div>
                                  </div>
                              </div>
                              <div class="event-card-footer">
                                  <div>
                                      <div class="event-card-footer-label">Registration</div>
                                      <span id="regStatus" class="@(Model.EventStatus == EnumEventStatus.Open ? "status-open" : "status-closed")">
                                          @(Model.EventStatus == EnumEventStatus.Open ? "Registration Open" : "Registration Closed")
                                      </span>
                                  </div>
                              </div>
                              <div class="event-url-row">
                                   <span id="eventUrl">@eventPageUrl</span>
                                  <button class="copy-btn" onclick="copyUrl()">COPY</button>
                              </div>
                          </div>
  
                           @* Share & Edit *@
                          <div class="share-row" style="margin-top:12px">
                              <span class="share-label">Share Event</span>
                              <div class="share-icons">
                                  <button type="button" class="share-icon-btn" onclick="shareEvent('facebook')" aria-label="Share on Facebook">
                                      <i class="fa-brands fa-facebook-f"></i>
                                  </button>
                                  <button type="button" class="share-icon-btn" onclick="shareEvent('x')" aria-label="Share on X">
                                      <i class="fa-brands fa-x-twitter"></i>
                                  </button>
                                  <button type="button" class="share-icon-btn" onclick="shareEvent('linkedin')" aria-label="Share on LinkedIn">
                                      <i class="fa-brands fa-linkedin-in"></i>
                                  </button>
                                  <button type="button" class="share-icon-btn" onclick="shareEvent('native')" aria-label="Share event link">
                                      <i class="fa-regular fa-comment-dots"></i>
                                  </button>
                              </div>
                          </div>
                      </div>
  
                      @* Right: When & Where *@
                      <div class="when-where">
                          <h3>When &amp; Where</h3>
                          <div class="when-block">
                              <div class="date-badge">
                                  <div class="date-badge-month">@Model.StartAt?.ToString("MMM").ToUpper()</div>
                                  <div class="date-badge-day">@Model.StartAt?.Day</div>
                              </div>
                              <div>
                                  <div class="when-title">
                                      @(Model.StartAt?.Date == DateTime.Today ? "Today" : Model.StartAt?.ToString("dddd dd, MMMM "))
                                  </div>
                                  <div class="when-sub" id="whenTime">
                                      @Model.StartAt?.ToString("h:mm tt") - @Model.EndAt?.ToString("h:mm tt")
                                  </div>
                              </div>
                          </div>
                          <div class="location-block">
                              <div class="loc-icon-box">  
                                <svg class="loc-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
                                    <g fill="none" fill-rule="evenodd" stroke="currentColor" stroke-linecap="round"stroke-linejoin="round" stroke-width="1.5">
                                        <path d="M2 6.854C2 11.02 7.04 15 8 15s6-3.98 6-8.146C14 3.621 11.314 1 8 1S2 3.62 2 6.854"></path>
                                        <path d="M9.5 6.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"></path>
                                    </g>
                                </svg>
                              </div>
                              <div>
                                  <div class="loc-name">@(Model.Location?.Length > 30 ? Model.Location.Substring(0, 30) + "..." : Model.Location)</div>
                                  <div class="loc-sub">@Model.Location</div>
                                  <div class="loc-note">The address is shown publicly on the event page.</div>
                              </div>
                          </div>
                          <div class="edit-btns">
                          <button class="btn-outline" onclick="openPanel()"><i class="fa-solid fa-pen"></i> Edit Event</button>
                          <button class="btn-outline" onclick="openCoverPicker()">
                              <i class="fa-solid fa-image"></i>
                              <span>Change Photo</span>
                          </button>
                      </div>
                      </div>
                  </div>
              </div>
  
              @* Stats *@
              <div class="stats-row">
                  <div class="stat-card highlight">
                      <div class="stat-value" id="statRegistered">@Model.UserEvents.Count(ue => ue.RequestStatus == EnumRequestStatus.Pending)</div>
                      <div class="stat-label">Total Applicants</div>
                  </div>
                  <div class="stat-card">
                      <div class="stat-value" id="statApproved">@Model.UserEvents.Count(ue => ue.RequestStatus == EnumRequestStatus.Accepted)</div>
                      <div class="stat-label">Selected</div>
                  </div>
                  <div class="stat-card">
                      <div class="stat-value" id="statCapacity">@Model.Capacity</div>
                      <div class="stat-label">Total Capacity</div>
                  </div>
              </div>
  
              @* Recent Registrants *@
              <div class="section">
                  <div class="section-header">
                      <div class="section-title">Participants</div>
                      <button class="btn-plus" onclick="switchTab(document.querySelectorAll('.tab')[1])">View All</button>
                  </div>
                  <div class="section-sub">Recent Applicants</div>
                   <div class="registrant-list">
                       @foreach (var reg in Model.Users)
                       {
                         var regAvatarIsDefault = string.IsNullOrWhiteSpace(reg.ProfilePictureUrl);
                         var regAvatar = regAvatarIsDefault ? defaultAvatar : reg.ProfilePictureUrl;
                         <div class="registrant-item">
                            <img class="reg-avatar @(regAvatarIsDefault ? "is-default-avatar" : "")" src="@regAvatar" alt="participant avatar" />
                            <div style="flex:1;">
                                <div class="reg-name">
                                    @reg.FirstName @reg.LastName 
                                    <span class="reg-Email">@reg.Email</span>
                                </div>
                            </div>
                            <div class="reg-time" style="margin-left:auto; white-space:nowrap;">
                                <span class="reg-status">@{UserEvent? userEvent = Model.UserEvents.FirstOrDefault(u => u.UserId == reg.Id);}@userEvent?.RequestStatus</span>
                                @Model.UserEvents.FirstOrDefault(u => u.UserId == reg.Id)?.RegisteredAt.ToString("dd MMM yyyy ,HH:mm")
                            </div>
                        </div>
                      }
                  </div>
              </div>
  
              @* Invites *@
              <div class="section">
                  <div class="section-header">
                      <div class="section-title">Invites</div>
                      <button class="btn-plus" onclick="openInviteModal()"><i class="fa-solid fa-plus"></i>Invite Guests</button>
                  </div>
                  <div class="section-sub">Invite subscribers, contacts and past guests via email or SMS.</div>
                  <div class="empty-state">
                      <div class="empty-icon"><i class="fa-regular fa-envelope"></i></div>
                      <div>
                          <div class="empty-title">Invites Sent</div>
                          <div class="empty-sub">You can invite subscribers, contacts and past guests to the event.</div>
                      </div>
                  </div>
              </div>
  
              @* Hosts *@
              <div class="section">
                  <div class="section-header">
                      <div class="section-title">Hosts</div>
                  </div>
                  <div style="margin-top:8px">
                      <div class="host-row">
                          <img class="host-avatar @(hostAvatarIsDefault ? "is-default-avatar" : "")" src="@hostAvatar" alt="host avatar" />
                          <div>
                              <span class="host-name">@Model.Owner.Username</span>
                              <span class="host-email">@Model.Owner.Email</span>
                              <span class="badge-creator">Creator</span>
                          </div>
                      </div>
                  </div>
              </div>
              @* Visibility & Discovery *@
              <div class="section">
                <div class="section-title" style="margin-bottom:4px">Visibility &amp; Discovery</div>
                <p class="section-sub">Control how people can find your event.</p>

                <div class="visibility-card">
                    <div style="flex:1">
                        <div class="section-title">@Model.Owner.Username</div>
                        <div style="margin-top:4px;font-size:13px">
                            @if (Model.JointType == EnumJointType.Public)
                            {
                                <span style="color:var(--green);font-weight:600">
                                    <i class="fa-solid fa-globe" style="font-size:11px"></i> Public
                                </span>
                                <span style="color:var(--text-secondary)">
                                    — This event is listed on the calendar page. Calendar admins have manage access to the event.
                                </span>
                            }
                            else
                            {
                                <span style="color:#d97706;font-weight:600">
                                    ✦ Private
                                </span>
                                <span style="color:var(--text-secondary)">
                                    — This event is not listed on the calendar page. Calendar admins have manage access to the event.
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="visibility-btns" style="margin-top:12px">
                    <button class="btn-outline sm" onclick="openVisibilityModal()"><i class="fa-solid fa-eye"></i> Change Visibility</button>
                </div>

                <div style="display:flex;align-items:flex-start;gap:10px;margin-top:16px;
                            font-size:12.5px;color:var(--text-muted);line-height:1.5">
                    <i class="fa-solid fa-globe" style="margin-top:2px;flex-shrink:0"></i>
                    <span>To be eligible for being featured on discovery pages and community calendars,
                          please set the visibility of the event to public.</span>
                </div>
            </div>
          </div>

          <div class="modal-overlay" id="visibilityOverlay" onclick="closeVisibilityModal(event)">
            <div class="invite-modal" style="width:420px;height:auto">
            
                <div class="invite-header">
                    <div class="invite-title">Change Visibility</div>
                    <button class="modal-close" onclick="closeVisibilityModal()">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
        
                <div style="padding:20px;display:flex;flex-direction:column;gap:10px">
                
                    <div class="confighost-option @(Model.JointType == EnumJointType.Public ? "selected" : "")" data-role="public" onclick="selectVisibility(this)">
                        <div class="confighost-option-left">
                            <div class="confighost-option-icon">
                                <i class="fa-solid fa-globe"></i>
                            </div>
                            <div>
                                <div class="confighost-option-name">Public</div>
                                <div class="confighost-option-desc">Anyone can join instantly without approval</div>
                            </div>
                        </div>
                        <div class="confighost-option-check">
                            <i class="fa-solid fa-check"></i>
                        </div>
                    </div>
        
                    <div class="confighost-option @(Model.JointType == EnumJointType.Private ? "selected" : "")" data-role="private" onclick="selectVisibility(this)">
                        <div class="confighost-option-left">
                            <div class="confighost-option-icon">
                                <i class="fa-solid fa-lock"></i>
                            </div>
                            <div>
                                <div class="confighost-option-name">Private</div>
                                <div class="confighost-option-desc">Applicants must be approved by the host before joining</div>
                            </div>
                        </div>
                        <div class="confighost-option-check">
                            <i class="fa-solid fa-check"></i>
                        </div>
                    </div>
        
                </div>
        
                <div style="padding:0 20px 20px">
                    <button class="confighost-send-btn" onclick="saveVisibility()">Save</button>
                </div>
        
            </div>
        </div>
  
          @* ══ TAB: GUESTS ══ *@
          <div id="tab-Guests" style="display:none">
              <div class="section">
                  <div class="section-header">
                      <div class="section-title">Participants List</div>
                      <div style="display:flex;gap:8px">
                      </div>
                  </div>
                    <div class="search-input-wrap">
                      <input class="form-input" id="participantSearch" placeholder="Search..." oninput="filterParticipants(this.value)" />
                  </div> 
                        <div class="filter-tabs" style="display:flex;gap:8px;margin-bottom:16px">
                            <button class="filter-btn active" onclick="filterByStatus(this, '')">All</button>
                            <button class="filter-btn" onclick="filterByStatus(this, 'Accepted')">Accepted</button>
                            <button class="filter-btn" data-private-only="true" onclick="filterByStatus(this, 'Pending')">Pending</button>
                            <button class="filter-btn" onclick="filterByStatus(this, 'Rejected')">Rejected</button>
                        </div>
                        <div class="registrant-list" id="participantList">
                            @foreach (var reg in Model.Users)
                            {
                                var userEvent = Model.UserEvents.FirstOrDefault(u => u.UserId == reg.Id);
                                var statusText = userEvent?.RequestStatus.ToString() ?? "Pending";
                                var regAvatarIsDefault = string.IsNullOrWhiteSpace(reg.ProfilePictureUrl);
                                var regAvatar = regAvatarIsDefault ? defaultAvatar : reg.ProfilePictureUrl;
                                <div class="registrant-item"
                                     data-user-id="@reg.Id"
                                     data-name="@reg.FirstName @reg.LastName"
                                     data-email="@reg.Email"
                                     data-status="@statusText">
                                    <img class="reg-avatar @(regAvatarIsDefault ? "is-default-avatar" : "")"
                                         src="@regAvatar"
                                         alt="participant avatar" />
                                    <div style="flex:1;">
                                        <div class="reg-name">
                                            @reg.FirstName @reg.LastName
                                            <span class="reg-Email">@reg.Email</span>
                                        </div>
                                    </div>
                                    <div class="reg-time participant-meta">
                                        <span class="reg-status participant-status" data-status-target>@statusText</span>
                                        <span class="reg-date">@userEvent?.RegisteredAt.ToString("dd MMM yyyy ,HH:mm")</span>
                                    </div>
                                    <div class="participant-actions">
                                        <button type="button" class="participant-action accept" data-status-value="Accepted" onclick="setParticipantStatus(this, 'Accepted')">Accept</button>
                                        <button type="button" class="participant-action pending" data-status-value="Pending" data-private-only="true" onclick="setParticipantStatus(this, 'Pending')">Pending</button>
                                        <button type="button" class="participant-action reject" data-status-value="Rejected" onclick="setParticipantStatus(this, 'Rejected')">Reject</button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div id="participantEmpty" style="display:none" class="empty-state">
                            <div class="empty-icon"><i class="fa-regular fa-user"></i></div>
                            <div>
                                <div class="empty-title">No participants found</div>
                                <div class="empty-sub">Try searching with a different name or email</div>
                            </div>
                        </div>
              </div>
          </div>
  
          @* ══ TAB: REGISTRATION ══ *@
          <div id="tab-Registration" style="display:none">
              <div class="section">
                  <div class="section-title" style="margin-bottom:16px">Registration Settings</div>
                  <div class="toggle-row">
                      <div>
                          <div class="toggle-label">Open Registration</div>
                          <div class="toggle-sub">Enable or disable registration for this event.</div>
                      </div>
                      <div class="toggle @(Model.EventStatus == EnumEventStatus.Open ? "on" : "")" id="regToggle2" onclick="toggleRegistration()"></div>
                  </div>
              </div>

              <div class="section">
                  <div class="section-title" style="margin-bottom:16px">Event Settings</div>
                  <div class="danger-zone">
                      <div>
                          <div class="toggle-label">Delete Event</div>
                          <div class="toggle-sub">Permanently delete this event and all registrations. This action cannot be undone.</div>
                      </div>
                      <button type="button" class="btn-danger-outline" id="deleteEventBtn" onclick="deleteEvent()">
                          <i class="fa-regular fa-trash-can"></i> Delete Event
                      </button>
                  </div>
              </div>
          </div>

      </main>
  
      @* ══ EDIT PANEL ══ *@
      <aside class="edit-panel"
             id="editPanel"
             data-event-id="@Model.Id"
             data-reg-open="@((Model.EventStatus == EnumEventStatus.Open).ToString().ToLower())"
             data-joint-type="@Model.JointType.ToString().ToLower()">
  
          <div class="panel-header">
              <div class="panel-title">Edit Event</div>
              <button class="panel-close" onclick="closePanel()"><i class="fa-solid fa-xmark"></i></button>
          </div>
  
          <div class="panel-body">
          
              @* Basic Info *@
              <div class="form-group">
                  <label class="form-label">EVENT TITLE</label>
                  <input class="form-input" id="inputTitle" value="@Model.Title" oninput="previewTitle(this.value)" />
              </div>
  
              <div class="form-group">
                  <label class="form-label">DESCRIPTION</label>
                  <textarea class="form-textarea" id="inputDesc">@Model.Info</textarea>
              </div>
  


              <div class="form-group">
                  <label class="form-label">CATEGORY</label>
                  <select class="form-select" id="inputCategory" data-selected-id="@Model.Category.Id">
                      <option value="@Model.Category.Id">@Model.Category.CategoryName</option>
                  </select>
              </div>
  
              <hr class="divider">
  
              @* Time *@
              <div class="form-group">
                  <label class="form-label">DATE &amp; TIME</label>
                  <input class="form-input" type="date" id="inputDate"
                         value="@Model.StartAt?.ToString("yyyy-MM-dd")"
                         style="margin-bottom:8px"
                         oninput="previewDate(this.value)" />
                  <div class="time-row">
                      <input class="form-input" type="time" id="inputStart"
                             value="@Model.StartAt?.ToString("HH:mm")"
                             oninput="previewTime()" />
                       <span class="time-separator">-&gt;</span>
                      <input class="form-input" type="time" id="inputEnd"
                             value="@Model.EndAt?.ToString("HH:mm")"
                             oninput="previewTime()" />
                  </div>
              </div>
  
              <hr class="divider">
  
              @* Location *@
              <div class="form-group">
                  <label class="form-label">LOCATION</label>
                  <input class="form-input" id="inputLocation" value="@Model.Location" />
              </div>
  
              <hr class="divider">
  
              @* Capacity *@
              <div class="form-group">
                   <label class="form-label">CAPACITY</label>
                  <div class="capacity-row">
                       <button class="capacity-adj" onclick="adjustCapacity(-1)">-</button>
                      <input class="form-input capacity-input" id="inputCapacity"
                             type="number" value="@Model.Capacity" min="1"
                             oninput="previewCapacity(this.value)" />
                      <button class="capacity-adj" onclick="adjustCapacity(1)">+</button>
                  </div>
              </div>  
          </div>
  
          <div class="panel-footer">
              <button class="btn-update" onclick="updateEvent()">
                  <i class="fa-solid fa-floppy-disk"></i> Update Event
              </button>
          </div>
  
      </aside>
  
  </div>
  
  @* ── TOAST ── *@
  <div class="toast" id="toast">
      <i class="fa-solid fa-circle-check"></i>
      <span id="toastMsg">Saved!</span>
  </div>

