@model OnlyFriends.Models.DTOS.EventDTOS.GetEventDTO
@using OnlyFriends.Models.DTOS.EventDTOS


<div class="addhost-overlay" id="addHostOverlay" onclick="closeAddHostModal(event)">
    <div class="addhost-modal">

                <div id="addHostStep1">

                    <div class="addhost-header">
                        <div class="addhost-icon">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>
                        <button class="addhost-close" onclick="closeAddHostModal()">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <div class="addhost-content">
                        <div class="addhost-title">Add Host</div>
                        <div class="addhost-desc">
                            Add a host to highlight them on the event page or to get help managing the event.
                        </div>

                        <div class="addhost-label">Enter Email or Search</div>
                        <input class="addhost-input" id="addHostInput"
                               placeholder="Search by name or email"
                               oninput="filterHostResults(this.value)" />

                        <div class="addhost-results" id="addHostResults">
                            @foreach (var user in Model.Users)
                            {
                                <div class="addhost-result-item"
                                     data-id="@user.Id"
                                     data-name="@(user.FirstName + " " + user.LastName)"
                                     data-email="@user.Email"
                                     data-avatar="@(user.ProfilePictureUrl ?? "")"
                                     onclick="goToStep2Host(this)">

                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                    {
                                        <img class="addhost-avatar"
                                             src="@user.ProfilePictureUrl"
                                             alt="@user.Username"
                                             onerror="this.style.display='none'" />
                                    }
                                    else
                                    {
                                        <div class="addhost-avatar-fallback"
                                             style="background:linear-gradient(135deg,#6c47ff,#a855f7)">
                                            @user.FirstName.Substring(0, 1).ToUpper()
                                        </div>
                                    }

                                    <div>
                                        <div class="addhost-user-name">@user.FirstName @user.LastName</div>
                                        <div class="addhost-user-email">@user.Email</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="addhost-empty" id="addHostEmpty" style="display:none">
                            <i class="fa-regular fa-user" style="font-size:20px;margin-bottom:6px;display:block"></i>
                            No users found
                        </div>
                    </div>
                </div>

                @* ════ STEP 2: Configure Host ════ *@
                <div id="addHostStep2" style="display:none">

                    <div class="confighost-header">
                        <div class="confighost-header-left">
                            <button class="confighost-back" onclick="goToStep1Host()">
                                <i class="fa-solid fa-chevron-left"></i>
                            </button>
                            <div class="confighost-title">Configure Host</div>
                        </div>
                        <button class="addhost-close" onclick="closeAddHostModal()">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    @* Selected User Info *@
                    <div class="confighost-user">
                        <img class="confighost-user-avatar" id="configHostImg"
                             src="" alt="" style="display:none"
                             onerror="this.style.display='none'" />
                        <div class="confighost-user-avatar-fallback" id="configHostFallback"
                             style="background:linear-gradient(135deg,#f97316,#ef4444)">
                        </div>
                        <div>
                            <div class="confighost-user-name"  id="configHostName">-</div>
                            <div class="confighost-user-email" id="configHostEmail">-</div>
                        </div>
                    </div>

                    @* Body *@
                    <div class="confighost-body">



                        @* Access Control *@
                        <div class="confighost-section-label">Access Control</div>
                        <div class="confighost-options">

                            <div class="confighost-option selected"
                                 data-role="Manager"
                                 onclick="selectAccessRole('Manager')">
                                <div class="confighost-option-left">
                                    <div class="confighost-option-icon">
                                        <i class="fa-solid fa-user-shield"></i>
                                    </div>
                                    <div>
                                        <div class="confighost-option-name">Manager</div>
                                        <div class="confighost-option-desc">Full manage access to the event</div>
                                    </div>
                                </div>
                                <div class="confighost-option-check">
                                    <i class="fa-solid fa-check"></i>
                                </div>
                            </div>

                            <div class="confighost-option"
                                 data-role="NonManager"
                                 onclick="selectAccessRole('NonManager')">
                                <div class="confighost-option-left">
                                    <div class="confighost-option-icon">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                    <div>
                                        <div class="confighost-option-name">Non-Manager</div>
                                        <div class="confighost-option-desc">No manage event access</div>
                                    </div>
                                </div>
                                <div class="confighost-option-check">
                                    <i class="fa-solid fa-check"></i>
                                </div>
                            </div>

                        </div>
                    </div>

                    @* Footer *@
                    <div class="confighost-footer">
                        <button class="confighost-send-btn" onclick="sendHostInvite()">
                            Send Invite
                        </button>
                    </div>

                </div>
                @* ── end step 2 ── *@

    </div>
</div>
