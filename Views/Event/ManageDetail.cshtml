@model OnlyFriends.Models.DTOS.EventDTOS.UpdateEventDTO
@using OnlyFriends.Models.DTOS.EventDTOS
@using OnlyFriends.Models
@{
    ViewData["Title"] = Model.Title?? "Manage Details";

    // ---- คำนวณจาก Event Model ----
    var participantCount = Model.UserEvents.Count;
    var pct              = Model.Capacity > 0 ? Math.Min((double)participantCount / Model.Capacity * 100, 100) : 0;
    var isExpired        = Model.EndAt.HasValue && Model.EndAt < DateTime.Now;
    var isClosed         = Model.EventStatus == EnumEventStatus.Closed || isExpired;
    var isFull           = participantCount >= Model.Capacity;
    var isOnline         = Model.EventType == EnumEventType.Online;
    var isPublic         = Model.JointType == EnumJointType.Public;

    // ---- ข้อมูลที่ Controller ต้อง pass มาใน ViewBag ----
    var isOwner          = (bool)(ViewBag.IsOwnerw ?? false);
    var isJoined         = (bool)(ViewBag.IsJoined ?? false);
    // isWinner = RequestStatus ของ user คนนี้ใน UserEvent เป็น Accepted
    var isWinner         = (bool)(ViewBag.IsWinner ?? false);
    // winnersAnnounced = มีคนถูก Accepted แล้วหรือยัง
    var winnersAnnounced = Model.UserEvents.Any(ue => ue.RequestStatus == EnumRequestStatus.Accepted);
}

<div class="container" style="padding-top:2rem;padding-bottom:3rem">

    <!-- Breadcrumb -->
    <nav style="font-size:0.82rem;color:var(--gray-500);margin-bottom:1.25rem">
        <a asp-action="Index" style="color:var(--gray-500)">กระดานกิจกรรม</a>
        <i class="bi bi-chevron-right" style="margin:0 0.4rem;font-size:0.7rem"></i>
        <span style="color:var(--gray-800)">@Model.Title</span>
    </nav>

    <div class="detail-layout">

        <!-- ===== MAIN CONTENT ===== -->
        <div class="detail-main">

            <!-- Post Header Card -->
            <div class="detail-card" style="margin-bottom:1.25rem">
                <div class="detail-card-body">

                    <!-- Title & Badges -->
                    <div class="d-flex align-center gap-2 flex-wrap mb-3">
                        <span class="category-tag" style="font-size:0.85rem">@Model.Category.Name</span>
                        <span class="badge @(isOnline ? "badge-primary" : "badge-gray")">
                            <i class="bi bi-@(isOnline ? "camera-video" : "geo-alt")"></i>
                            @(isOnline ? "Online" : "Offline")
                        </span>
                        <span class="badge @(isPublic ? "badge-success" : "badge-warning")">
                            <i class="bi bi-@(isPublic ? "globe" : "lock")"></i>
                            @(isPublic ? "Public" : "Private")
                        </span>
                        @if (isClosed)
                        {
                            <span class="badge badge-closed">🔒 ปิดรับสมัคร</span>
                        }
                        else if (isFull)
                        {
                            <span class="badge badge-danger">🔴 เต็มแล้ว</span>
                        }
                        else
                        {
                            <span class="badge badge-success">✅ รับสมัครอยู่</span>
                        }
                        @if (winnersAnnounced)
                        {
                            <span class="badge badge-primary"><i class="bi bi-trophy"></i> ประกาศผลแล้ว</span>
                        }
                    </div>

                    <h1 class="post-full-title">@Model.Title</h1>

                    <!-- Poster Image -->
                    @if (!string.IsNullOrEmpty(Model.PosterUrl))
                    {
                        <img src="@Model.PosterUrl" alt="@Model.Title"
                             style="width:100%;max-height:320px;object-fit:cover;border-radius:var(--radius);margin-bottom:1.25rem" />
                    }

                    <div class="post-full-meta">
                        <div class="meta-item">
                            <i class="bi bi-person-circle"></i>
                            <span>โดย <strong>@Model.Owner.Username</strong></span>
                        </div>
                        @if (Model.StartAt.HasValue)
                        {
                            <div class="meta-item">
                                <i class="bi bi-calendar-event"></i>
                                <span>เริ่ม <strong>@Model.StartAt.Value.ToString("d MMM yyyy HH:mm")</strong></span>
                            </div>
                        }
                        @if (Model.EndAt.HasValue)
                        {
                            <div class="meta-item">
                                <i class="bi bi-calendar-x"></i>
                                <span style="@(isExpired ? "color:var(--danger)" : "")">
                                    สิ้นสุด <strong>@Model.EndAt.Value.ToString("d MMM yyyy HH:mm")</strong>
                                </span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Location))
                        {
                            <div class="meta-item">
                                <i class="bi bi-geo-alt"></i>
                                <span>@Model.Location</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.TimeZone))
                        {
                            <div class="meta-item">
                                <i class="bi bi-clock-history"></i>
                                <span>@Model.TimeZone</span>
                            </div>
                        }
                    </div>

                    <div class="post-content">
                        @Html.Raw(Html.Encode(Model.Info).Replace("\n", "<br/>"))
                    </div>

                    <!-- Owner Actions -->
                    @if (isOwner)
                    {
                        <div class="d-flex gap-2 flex-wrap" style="padding-top:1rem;border-top:1px solid var(--gray-100)">
                            @if (!isClosed)
                            {
                                <button class="btn btn-secondary btn-sm btn-close-post" data-post-id="@Model.Id">
                                    <i class="bi bi-lock"></i> ปิดรับสมัคร
                                </button>
                            }
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm">
                                <i class="bi bi-pencil"></i> แก้ไข Event
                            </a>
                            <button class="btn btn-danger btn-sm btn-delete-post" data-post-id="@Model.Id">
                                <i class="bi bi-trash"></i> ลบ Event
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Tabs: Applicants / Winners -->
            <div class="detail-card">
                <div class="detail-card-header">
                    <h3><i class="bi bi-people"></i> ผู้สมัครเข้าร่วม</h3>
                    <span class="badge badge-primary">@participantCount คน</span>
                </div>

                <div class="tabs" style="margin:0 1.5rem;border-radius:0">
                    <div class="tab-item active" data-tab="tab-applicants">
                        <i class="bi bi-list-check"></i> รายชื่อผู้สมัคร (@participantCount)
                    </div>
                    @if (winnersAnnounced || isOwner)
                    {
                        <div class="tab-item" data-tab="tab-winners">
                            <i class="bi bi-trophy"></i> ผู้ได้รับเลือก (@Model.UserEvents.Count(ue => ue.RequestStatus == EnumRequestStatus.Accepted))
                        </div>
                    }
                </div>

                <div>
                    <!-- Applicants Tab -->
                    <div id="tab-applicants" class="tab-content active" style="padding:1.5rem">
                        @if (!Model.UserEvents.Any())
                        {
                            <div class="empty-state" style="padding:2.5rem 1rem">
                                <div class="empty-icon">👥</div>
                                <div class="empty-title">ยังไม่มีผู้สมัคร</div>
                                <div class="empty-text">เป็นคนแรกที่สมัครเข้าร่วมกิจกรรมนี้!</div>
                            </div>
                        }
                        else
                        {
                            <!-- Owner: Select winners UI -->
                            @if (isOwner && isClosed && !winnersAnnounced)
                            {
                                <div class="alert alert-info mb-4">
                                    <i class="bi bi-info-circle"></i>
                                    <div>
                                        <strong>เลือกผู้ที่ได้รับการคัดเลือก</strong>
                                        <div style="margin-top:0.25rem">เลือกได้สูงสุด @Model.Capacity คน (เลือกแล้ว: <span id="selected-count">0</span>)</div>
                                    </div>
                                </div>

                                <div id="applicants-selection" data-post-id="@Model.Id" data-max="@Model.Capacity"
                                     class="applicants-list">
                                    @foreach (var ue in Model.UserEvents)
                                    {
                                        <div class="applicant-item">
                                            <div class="applicant-info">
                                                <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer">
                                                    <input type="checkbox" value="@ue.UserId"
                                                           style="width:18px;height:18px;cursor:pointer;accent-color:var(--primary)" />
                                                    <div class="applicant-avatar">@ue.User.Username[0].ToString().ToUpper()</div>
                                                    <div>
                                                        <div class="applicant-name">@ue.User.Username</div>
                                                        <div class="applicant-date">@ue.User.Email</div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="text-center mt-4">
                                    <button id="btn-confirm-selection" class="btn btn-primary" disabled>
                                        <i class="bi bi-trophy"></i> ประกาศผลการคัดเลือก
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="applicants-list">
                                    @foreach (var ue in Model.UserEvents)
                                    {
                                        <div class="applicant-item">
                                            <div class="applicant-info">
                                                <div class="applicant-avatar">@ue.User.Username[0].ToString().ToUpper()</div>
                                                <div>
                                                    <div class="applicant-name">@ue.User.Username</div>
                                                    <div class="applicant-date">@ue.User.Email</div>
                                                </div>
                                            </div>
                                            <div>
                                                @if (winnersAnnounced)
                                                {
                                                    @if (ue.RequestStatus == EnumRequestStatus.Accepted)
                                                    {
                                                        <span class="badge badge-success"><i class="bi bi-check-circle"></i> ได้รับเลือก</span>
                                                    }
                                                    else if (ue.RequestStatus == EnumRequestStatus.Rejected)
                                                    {
                                                        <span class="badge badge-gray">ไม่ได้รับเลือก</span>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <!-- Winners Tab -->
                    @if (winnersAnnounced || isOwner)
                    {
                        @{var winners = Model.UserEvents.Where(ue => ue.RequestStatus == EnumRequestStatus.Accepted).ToList();}
                        <div id="tab-winners" class="tab-content" style="padding:1.5rem">
                            @if (!winners.Any())
                            {
                                <div class="empty-state" style="padding:2rem 1rem">
                                    <div class="empty-icon">🏆</div>
                                    <div class="empty-title">ยังไม่ได้ประกาศผล</div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success mb-3">
                                    <i class="bi bi-trophy-fill"></i>
                                    <strong>ประกาศผลการคัดเลือกแล้ว! มีผู้ได้รับเลือก @winners.Count คน</strong>
                                </div>
                                <div class="applicants-list">
                                    @foreach (var ue in winners)
                                    {
                                        <div class="applicant-item" style="border-color:var(--success-light);background:var(--success-light)">
                                            <div class="applicant-info">
                                                <div class="applicant-avatar" style="background:var(--success);color:white">
                                                    @ue.User.Username[0].ToString().ToUpper()
                                                </div>
                                                <div>
                                                    <div class="applicant-name">@ue.User.Username</div>
                                                    <div class="applicant-date">@ue.User.Email</div>
                                                </div>
                                            </div>
                                            <span class="badge badge-success"><i class="bi bi-trophy"></i> ได้รับเลือก</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- ===== SIDEBAR ===== -->
        <div class="detail-sidebar">

            <!-- Join / Status Box -->
            <div class="info-box" style="margin-bottom:1rem;overflow:visible">
                <div class="capacity-display">
                    <div class="capacity-numbers">
                        @participantCount<span>/@Model.Capacity</span>
                    </div>
                    <div class="capacity-label">จำนวนผู้สมัคร / ที่รับสมัคร</div>
                    <div class="capacity-bar">
                        <div class="capacity-fill @(pct >= 100 ? "full" : pct >= 75 ? "near" : "")"
                             style="width:@(pct.ToString("F0"))%"></div>
                    </div>
                </div>

                <div class="join-section">
                    @if (!User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@Context.Request.Path"
                           class="btn btn-primary join-btn">
                            <i class="bi bi-box-arrow-in-right"></i> เข้าสู่ระบบเพื่อสมัคร
                        </a>
                    }
                    else if (isOwner)
                    {
                        <div class="badge badge-primary" style="padding:0.75rem;font-size:0.875rem;border-radius:var(--radius);display:block">
                            <i class="bi bi-person-check"></i> คุณเป็นเจ้าของ Event นี้
                        </div>
                    }
                    else if (winnersAnnounced)
                    {
                        if (isWinner)
                        {
                            <div class="alert alert-success" style="margin:0">
                                <i class="bi bi-trophy-fill"></i>
                                <strong>ยินดีด้วย! คุณได้รับเลือกเข้าร่วมกิจกรรม</strong>
                            </div>
                        }
                        else if (isJoined)
                        {
                            <div class="alert alert-warning" style="margin:0">
                                <i class="bi bi-info-circle"></i>
                                ขออภัย คุณไม่ได้รับการคัดเลือกในรอบนี้
                            </div>
                        }
                        else
                        {
                            <div class="badge badge-closed" style="padding:0.75rem;border-radius:var(--radius);display:block;font-size:0.875rem">
                                ปิดรับสมัครแล้ว
                            </div>
                        }
                    }
                    else if (isClosed || isExpired)
                    {
                        <button class="btn join-btn" disabled style="background:var(--gray-200);color:var(--gray-500)">
                            <i class="bi bi-lock"></i> ปิดรับสมัครแล้ว
                        </button>
                    }
                    else if (isFull && !isJoined)
                    {
                        <button class="btn join-btn" disabled style="background:var(--danger-light);color:var(--danger)">
                            <i class="bi bi-x-circle"></i> ที่นั่งเต็มแล้ว
                        </button>
                        <div class="join-message">กิจกรรมนี้มีผู้สมัครเต็มจำนวนแล้ว</div>
                    }
                    else if (isJoined)
                    {
                        <button class="btn btn-secondary join-btn btn-join"
                                data-post-id="@Model.Id"
                                data-action="leave">
                            <i class="bi bi-x-circle"></i> ยกเลิกการเข้าร่วม
                        </button>
                        <div class="join-message">✓ คุณสมัครเข้าร่วมแล้ว รอการประกาศผล</div>
                    }
                    else
                    {
                        <button class="btn btn-success join-btn btn-join"
                                data-post-id="@Model.Id"
                                data-action="join">
                            <i class="bi bi-person-plus"></i> สมัครเข้าร่วม
                        </button>
                        <div class="join-message">ยังมีที่ว่าง @(Model.Capacity - participantCount) ที่</div>
                    }
                </div>
            </div>

            <!-- Info Box -->
            <div class="info-box">
                <div class="info-box-header">
                    <i class="bi bi-info-circle" style="color:var(--primary)"></i> ข้อมูลกิจกรรม
                </div>
                <div class="info-box-body">
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-tag"></i> หมวดหมู่</span>
                        <span class="info-value">@Model.Category.Name</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-people"></i> รับสมาชิก</span>
                        <span class="info-value">@Model.Capacity คน</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-camera-video"></i> ประเภท</span>
                        <span class="info-value">@(isOnline ? "Online" : "Offline")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-globe"></i> การเข้าร่วม</span>
                        <span class="info-value">@(isPublic ? "สาธารณะ" : "เฉพาะเชิญ")</span>
                    </div>
                    @if (Model.StartAt.HasValue)
                    {
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-calendar-event"></i> เริ่ม</span>
                            <span class="info-value">@Model.StartAt.Value.ToString("d MMM yyyy HH:mm")</span>
                        </div>
                    }
                    @if (Model.EndAt.HasValue)
                    {
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-calendar-x"></i> สิ้นสุด</span>
                            <span class="info-value" style="@(isExpired ? "color:var(--danger)" : "")">
                                @Model.EndAt.Value.ToString("d MMM yyyy HH:mm")
                            </span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-geo-alt"></i> สถานที่</span>
                            <span class="info-value">@Model.Location</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TimeZone))
                    {
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-clock"></i> Timezone</span>
                            <span class="info-value">@Model.TimeZone</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Countdown Timer (นับถอยหลังถึง EndAt) -->
            @if (Model.EndAt.HasValue && !isExpired && !isClosed)
            {
                <div class="info-box">
                    <div class="info-box-header">
                        <i class="bi bi-hourglass-split" style="color:var(--accent)"></i> เวลาที่เหลือ
                    </div>
                    <div class="countdown" data-countdown="@Model.EndAt.Value.ToString("o")">
                        <div class="countdown-item">
                            <span class="countdown-value" data-cd-days>--</span>
                            <div class="countdown-label">วัน</div>
                        </div>
                        <div class="countdown-item">
                            <span class="countdown-value" data-cd-hours>--</span>
                            <div class="countdown-label">ชั่วโมง</div>
                        </div>
                        <div class="countdown-item">
                            <span class="countdown-value" data-cd-mins>--</span>
                            <div class="countdown-label">นาที</div>
                        </div>
                        <div class="countdown-item">
                            <span class="countdown-value" data-cd-secs>--</span>
                            <div class="countdown-label">วินาที</div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
