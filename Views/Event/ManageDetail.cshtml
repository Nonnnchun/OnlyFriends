@* @model OnlyFriends.Models.DTOS.EventDTOS.UpdateEventDTO
@using OnlyFriends.Models.DTOS.EventDTOS
@
@{
    ViewData["Title"] = Model.Post.Title;
    var post = Model.Post;
    var pct = post.MaxMembers > 0 ? Math.Min((double)post.ApplicantCount / post.MaxMembers * 100, 100) : 0;
    var isExpired = post.ExpiresAt.HasValue && post.ExpiresAt < DateTime.Now;
    var isClosed = post.IsClosed || isExpired;
    var isFull = post.ApplicantCount >= post.MaxMembers;
    var isOwner = Model.IsOwner;
    var isJoined = Model.IsUserJoined;
    var isWinner = Model.IsUserWinner;
    var winnersAnnounced = Model.WinnersAnnounced;
}

<div class="container" style="padding-top:2rem;padding-bottom:3rem">

    <!-- Breadcrumb -->
    <nav style="font-size:0.82rem;color:var(--gray-500);margin-bottom:1.25rem">
        <a asp-action="Index" style="color:var(--gray-500)">กระดานกิจกรรม</a>
        <i class="bi bi-chevron-right" style="margin:0 0.4rem;font-size:0.7rem"></i>
        <span style="color:var(--gray-800)">@post.Title</span>
    </nav>

    <div class="detail-layout">

        <!-- ===== MAIN CONTENT ===== -->
        <div class="detail-main">

            <!-- Post Header Card -->
            <div class="detail-card" style="margin-bottom:1.25rem">
                <div class="detail-card-body">

                    <!-- Title & Badges -->
                    <div class="d-flex align-center gap-2 flex-wrap mb-3">
                        <span class="category-tag" style="font-size:0.85rem">@post.Category</span>
                        @if (isClosed)
                        {
                            <span class="badge badge-closed">🔒 ปิดรับสมัคร</span>
                        }
                        else if (isFull)
                        {
                            <span class="badge badge-danger">🔴 เต็มแล้ว</span>
                        }
                        else
                        {
                            <span class="badge badge-success">✅ รับสมัครอยู่</span>
                        }
                        @if (winnersAnnounced)
                        {
                            <span class="badge badge-primary"><i class="bi bi-trophy"></i> ประกาศผลแล้ว</span>
                        }
                    </div>

                    <h1 class="post-full-title">@post.Title</h1>

                    <div class="post-full-meta">
                        <div class="meta-item">
                            <i class="bi bi-person-circle"></i>
                            <span>โดย <strong>@post.OwnerName</strong></span>
                        </div>
                        <div class="meta-item">
                            <i class="bi bi-calendar3"></i>
                            <span>@post.CreatedAt.ToString("d MMMM yyyy HH:mm")</span>
                        </div>
                        @if (post.Location != null)
                        {
                            <div class="meta-item">
                                <i class="bi bi-geo-alt"></i>
                                <span>@post.Location</span>
                            </div>
                        }
                        @if (post.ActivityDate.HasValue)
                        {
                            <div class="meta-item">
                                <i class="bi bi-calendar-event"></i>
                                <span>วันกิจกรรม: <strong>@post.ActivityDate.Value.ToString("d MMMM yyyy")</strong></span>
                            </div>
                        }
                    </div>

                    <div class="post-content">
                        @Html.Raw(Html.Encode(post.Description).Replace("\n", "<br/>"))
                    </div>

                    <!-- Owner Actions -->
                    @if (isOwner)
                    {
                        <div class="d-flex gap-2 flex-wrap" style="padding-top:1rem;border-top:1px solid var(--gray-100)">
                            @if (!isClosed)
                            {
                                <button class="btn btn-secondary btn-sm btn-close-post" data-post-id="@post.Id">
                                    <i class="bi bi-lock"></i> ปิดรับสมัคร
                                </button>
                            }
                            <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-secondary btn-sm">
                                <i class="bi bi-pencil"></i> แก้ไขโพสต์
                            </a>
                            <button class="btn btn-danger btn-sm btn-delete-post" data-post-id="@post.Id">
                                <i class="bi bi-trash"></i> ลบโพสต์
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Tabs: Applicants / Winners -->
            <div class="detail-card">
                <div class="detail-card-header">
                    <h3><i class="bi bi-people"></i> ผู้สมัครเข้าร่วม</h3>
                    <span class="badge badge-primary">@post.ApplicantCount คน</span>
                </div>

                <div class="tabs" style="margin:0 1.5rem;border-radius:0">
                    <div class="tab-item active" data-tab="tab-applicants">
                        <i class="bi bi-list-check"></i> รายชื่อผู้สมัคร (@post.ApplicantCount)
                    </div>
                    @if (winnersAnnounced || isOwner)
                    {
                        <div class="tab-item" data-tab="tab-winners">
                            <i class="bi bi-trophy"></i> ผู้ได้รับเลือก (@Model.Winners.Count)
                        </div>
                    }
                </div>

                <div>
                    <!-- Applicants Tab -->
                    <div id="tab-applicants" class="tab-content active" style="padding:1.5rem">
                        @if (!Model.Applicants.Any())
                        {
                            <div class="empty-state" style="padding:2.5rem 1rem">
                                <div class="empty-icon">👥</div>
                                <div class="empty-title">ยังไม่มีผู้สมัคร</div>
                                <div class="empty-text">เป็นคนแรกที่สมัครเข้าร่วมกิจกรรมนี้!</div>
                            </div>
                        }
                        else
                        {
                            <!-- Owner: Select winners UI -->
                            @if (isOwner && isClosed && !winnersAnnounced)
                            {
                                <div class="alert alert-info mb-4">
                                    <i class="bi bi-info-circle"></i>
                                    <div>
                                        <strong>เลือกผู้ที่ได้รับการคัดเลือก</strong>
                                        <div style="margin-top:0.25rem">เลือกได้สูงสุด @post.MaxMembers คน (เลือกแล้ว: <span id="selected-count">0</span>)</div>
                                    </div>
                                </div>

                                <div id="applicants-selection" data-post-id="@post.Id" data-max="@post.MaxMembers"
                                     class="applicants-list">
                                    @foreach (var applicant in Model.Applicants)
                                    {
                                        <div class="applicant-item">
                                            <div class="applicant-info">
                                                <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer">
                                                    <input type="checkbox" value="@applicant.UserId"
                                                           style="width:18px;height:18px;cursor:pointer;accent-color:var(--primary)" />
                                                    <div class="applicant-avatar">@applicant.UserName[0].ToString().ToUpper()</div>
                                                    <div>
                                                        <div class="applicant-name">@applicant.UserName</div>
                                                        <div class="applicant-date">สมัครเมื่อ @applicant.AppliedAt.ToString("d MMM yyyy HH:mm")</div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="text-center mt-4">
                                    <button id="btn-confirm-selection" class="btn btn-primary" disabled>
                                        <i class="bi bi-trophy"></i> ประกาศผลการคัดเลือก
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="applicants-list">
                                    @foreach (var applicant in Model.Applicants)
                                    {
                                        <div class="applicant-item">
                                            <div class="applicant-info">
                                                <div class="applicant-avatar">@applicant.UserName[0].ToString().ToUpper()</div>
                                                <div>
                                                    <div class="applicant-name">@applicant.UserName</div>
                                                    <div class="applicant-date">สมัครเมื่อ @applicant.AppliedAt.ToString("d MMM yyyy HH:mm")</div>
                                                </div>
                                            </div>
                                            <div>
                                                @if (winnersAnnounced)
                                                {
                                                    @if (Model.Winners.Any(w => w.UserId == applicant.UserId))
                                                    {
                                                        <span class="badge badge-success"><i class="bi bi-check-circle"></i> ได้รับเลือก</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-gray">ไม่ได้รับเลือก</span>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <!-- Winners Tab -->
                    @if (winnersAnnounced || isOwner)
                    {
                        <div id="tab-winners" class="tab-content" style="padding:1.5rem">
                            @if (!Model.Winners.Any())
                            {
                                <div class="empty-state" style="padding:2rem 1rem">
                                    <div class="empty-icon">🏆</div>
                                    <div class="empty-title">ยังไม่ได้ประกาศผล</div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success mb-3">
                                    <i class="bi bi-trophy-fill"></i>
                                    <strong>ประกาศผลการคัดเลือกแล้ว! มีผู้ได้รับเลือก @Model.Winners.Count คน</strong>
                                </div>
                                <div class="applicants-list">
                                    @foreach (var winner in Model.Winners)
                                    {
                                        <div class="applicant-item" style="border-color:var(--success-light);background:var(--success-light)">
                                            <div class="applicant-info">
                                                <div class="applicant-avatar" style="background:var(--success);color:white">
                                                    @winner.UserName[0].ToString().ToUpper()
                                                </div>
                                                <div>
                                                    <div class="applicant-name">@winner.UserName</div>
                                                    <div class="applicant-date">@winner.Email</div>
                                                </div>
                                            </div>
                                            <span class="badge badge-success"><i class="bi bi-trophy"></i> ได้รับเลือก</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- ===== SIDEBAR ===== -->
        <div class="detail-sidebar">

            <!-- Join / Status Box -->
            <div class="info-box" style="margin-bottom:1rem;overflow:visible">
                <div class="capacity-display">
                    <div class="capacity-numbers">
                        @post.ApplicantCount<span>/@post.MaxMembers</span>
                    </div>
                    <div class="capacity-label">จำนวนผู้สมัคร / ที่รับสมัคร</div>
                    <div class="capacity-bar">
                        <div class="capacity-fill @(pct >= 100 ? "full" : pct >= 75 ? "near" : "")"
                             style="width:@(pct.ToString("F0"))%"></div>
                    </div>
                </div>

                <div class="join-section">
                    @if (!User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@Context.Request.Path"
                           class="btn btn-primary join-btn">
                            <i class="bi bi-box-arrow-in-right"></i> เข้าสู่ระบบเพื่อสมัคร
                        </a>
                    }
                    else if (isOwner)
                    {
                        <div class="badge badge-primary" style="padding:0.75rem;font-size:0.875rem;border-radius:var(--radius);display:block">
                            <i class="bi bi-person-check"></i> คุณเป็นเจ้าของโพสต์นี้
                        </div>
                    }
                    else if (winnersAnnounced)
                    {
                        if (isWinner)
                        {
                            <div class="alert alert-success" style="margin:0">
                                <i class="bi bi-trophy-fill"></i>
                                <strong>ยินดีด้วย! คุณได้รับเลือกเข้าร่วมกิจกรรม</strong>
                            </div>
                        }
                        else if (isJoined)
                        {
                            <div class="alert alert-warning" style="margin:0">
                                <i class="bi bi-info-circle"></i>
                                ขออภัย คุณไม่ได้รับการคัดเลือกในรอบนี้
                            </div>
                        }
                        else
                        {
                            <div class="badge badge-closed" style="padding:0.75rem;border-radius:var(--radius);display:block;font-size:0.875rem">
                                ปิดรับสมัครแล้ว
                            </div>
                        }
                    }
                    else if (isClosed || isExpired)
                    {
                        <button class="btn join-btn" disabled style="background:var(--gray-200);color:var(--gray-500)">
                            <i class="bi bi-lock"></i> ปิดรับสมัครแล้ว
                        </button>
                    }
                    else if (isFull && !isJoined)
                    {
                        <button class="btn join-btn" disabled style="background:var(--danger-light);color:var(--danger)">
                            <i class="bi bi-x-circle"></i> ที่นั่งเต็มแล้ว
                        </button>
                        <div class="join-message">กิจกรรมนี้มีผู้สมัครเต็มจำนวนแล้ว</div>
                    }
                    else if (isJoined)
                    {
                        <button class="btn btn-secondary join-btn btn-join"
                                data-post-id="@post.Id"
                                data-action="leave">
                            <i class="bi bi-x-circle"></i> ยกเลิกการเข้าร่วม
                        </button>
                        <div class="join-message">✓ คุณสมัครเข้าร่วมแล้ว รอการประกาศผล</div>
                    }
                    else
                    {
                        <button class="btn btn-success join-btn btn-join"
                                data-post-id="@post.Id"
                                data-action="join">
                            <i class="bi bi-person-plus"></i> สมัครเข้าร่วม
                        </button>
                        <div class="join-message">ยังมีที่ว่าง @(post.MaxMembers - post.ApplicantCount) ที่</div>
                    }
                </div>
            </div>

            <!-- Info Box -->
            <div class="info-box">
                <div class="info-box-header">
                    <i class="bi bi-info-circle" style="color:var(--primary)"></i> ข้อมูลกิจกรรม
                </div>
                <div class="info-box-body">
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-tag"></i> หมวดหมู่</span>
                        <span class="info-value">@post.Category</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-people"></i> รับสมาชิก</span>
                        <span class="info-value">@post.MaxMembers คน</span>
                    </div>
                    @if (post.ActivityDate.HasValue)
                    {
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-calendar-event"></i> วันกิจกรรม</span>
                            <span class="info-value">@post.ActivityDate.Value.ToString("d MMM yyyy")</span>
                        </div>
                    }
                    @if (post.Location != null)
                    {
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-geo-alt"></i> สถานที่</span>
                            <span class="info-value">@post.Location</span>
                        </div>
                    }
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-calendar-plus"></i> โพสต์เมื่อ</span>
                        <span class="info-value">@post.CreatedAt.ToString("d MMM yyyy")</span>
                    </div>
                    @if (post.ExpiresAt.HasValue)
                    {
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-hourglass"></i> หมดอายุ</span>
                            <span class="info-value" style="@(isExpired ? "color:var(--danger)" : "")">
                                @post.ExpiresAt.Value.ToString("d MMM yyyy HH:mm")
                            </span>
                        </div>
                    }
                </div>
            </div>

            <!-- Countdown Timer -->
            @if (post.ExpiresAt.HasValue && !isExpired && !isClosed)
            {
                <div class="info-box">
                    <div class="info-box-header">
                        <i class="bi bi-hourglass-split" style="color:var(--accent)"></i> เวลาที่เหลือ
                    </div>
                    <div class="countdown" data-countdown="@post.ExpiresAt.Value.ToString("o")">
                        <div class="countdown-item">
                            <span class="countdown-value" data-cd-days>--</span>
                            <div class="countdown-label">วัน</div>
                        </div>
                        <div class="countdown-item">
                            <span class="countdown-value" data-cd-hours>--</span>
                            <div class="countdown-label">ชั่วโมง</div>
                        </div>
                        <div class="countdown-item">
                            <span class="countdown-value" data-cd-mins>--</span>
                            <div class="countdown-label">นาที</div>
                        </div>
                        <div class="countdown-item">
                            <span class="countdown-value" data-cd-secs>--</span>
                            <div class="countdown-label">วินาที</div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div> *@
