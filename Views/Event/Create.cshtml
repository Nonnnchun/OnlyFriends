@using OnlyFriends.Models.DTOS.EventDTOS
@using OnlyFriends.Models.DTOS.CategoryDTOS
@model CreateEventDTO
@{
    ViewData["Title"] = "สร้างกิจกรรม";
    var categories = ViewData["Categories"] as IEnumerable<GetCategoryDTO>;
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
}
<div class="create-container">
    <div class="left-col">
        <div class="poster-preview">
            <button class="upload-btn" title="อัปโหลดรูปภาพ">📷</button>
            <input type="file" id="posterInput" style="display: none;" accept="image/*">
        </div>
    </div>

    <div class="right-col">
        <div class="top-actions" style="text-align: right; margin-bottom: 10px;">
            <select class="dropdown-badge custom-select" id="eventVisibility">
                <option value="Public">Public</option>
                <option value="Private">Private</option>
            </select>
        </div>

        <input type="text" id="eventTitle" class="title-input" placeholder="ชื่อกิจกรรม">

        <div class="schedule-wrapper">
            <div class="datetime-block">
                <div class="timeline-line"></div>

                <div class="dt-row">
                    <div class="dt-label">
                        <div class="dot-solid"></div>
                        เริ่ม
                    </div>
                    <div class="dt-input-group">
                        <input type="date" id="startDate">
                        <input type="time" id="startTime" value="16:30">
                    </div>
                </div>

                <div class="dt-row">
                    <div class="dt-label">
                        <div class="dot-outline"></div>
                        จบ
                    </div>
                    <div class="dt-input-group">
                        <input type="date" id="endDate">
                        <input type="time" id="endTime" value="17:30">
                    </div>
                </div>
            </div>

            <div class="timezone-block">
                <div style="color: #9aa0a6; font-size: 1.2rem; margin-bottom: 5px;">🌐</div>
                <div class="timezone-text">GMT+07:00</div>
                <div class="timezone-subtext">กรุงเทพมหานคร</div>
            </div>
        </div>

        <div class="input-group" style="display: flex; gap: 10px; align-items: center;">
            <span>📍</span>
            <input type="text" id="eventLocation" placeholder="ค้นหาสถานที่จัดงาน หรือลากหมุดบนแผนที่..." style="flex: 1; border: none; outline: none; background: transparent;">
            <button type="button" id="btnSearchLocation" class="btn-search-loc" onclick="searchOSMLocation()">ค้นหา</button>
        </div>

        <input type="hidden" id="Latitude" name="Latitude">
        <input type="hidden" id="Longitude" name="Longitude">

        <div id="mapContainer" style="width: 100%; height: 300px; border-radius: 12px; margin-bottom: 15px; border: 1px solid #ced4da; overflow: hidden; display: block;">
            <div id="map" style="width: 100%; height: 100%;"></div>
        </div>
        <div class="input-group">
            <span>📝</span>
            <input type="text" id="eventInfo" placeholder="เพิ่มคำอธิบาย">
        </div>
        <div class="input-group" style="flex-direction: column; align-items: stretch;">
            <span style="margin-bottom:5px;">🏷️ หมวดหมู่กิจกรรม</span>

            <div id="categoryContainer">
                <div class="category-row" style="display:flex; gap:10px; margin-bottom:8px;">
                    <select class="eventCategorySelect"
                            style="flex:1; border:1px solid #ced4da; border-radius:6px; padding:6px;">
                        <option value="">เลือกหมวดหมู่</option>
                        @if (categories != null) {
                            @foreach (var category in categories) 
                            {
                                <option value="@category.Id">@category.CategoryName</option>
                            }
                        }
                    </select>

                    <button type="button"
                            onclick="addCategoryRow(this)"
                            style="border:none; background:#e9ecef; border-radius:6px; padding:6px 10px; cursor:pointer;">
                        ➕
                    </button>
                </div>
            </div>
        </div>
        <div class="section-title">ตัวเลือกกิจกรรม</div>
        <div class="form-section">
            <div class="option-row">
                <span>💻 รูปแบบการจัดงาน</span>
                <select id="eventType" onchange="updateLocationPlaceholder()" style="border: none; background: transparent; color: var(--primary-color); font-weight: bold; cursor: pointer; outline: none; text-align: right;">
                    <option value="offline">ออฟไลน์ (สถานที่จริง)</option>
                    <option value="online">ออนไลน์ (Virtual)</option>
                </select>
            </div>
            <div class="option-row">
                <span>🎟️ ค่าใช้จ่าย</span>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <select id="ticketType" onchange="togglePriceInput()"
                            style="border: none; background: transparent; color: var(--primary-color); font-weight: bold; cursor: pointer; outline: none; text-align: right;">
                        <option value="free">ฟรี</option>
                        <option value="paid">มีค่าใช้จ่าย</option>
                    </select>

                    <div id="priceInputContainer" style="display: none; align-items: center; gap: 5px;">
                        <input type="number" id="ticketPrice" placeholder="0" min="0"
                               style="width: 70px; border: 1px solid #ced4da; border-radius: 4px; padding: 4px 8px; text-align: right; background: white;">
                        <span style="color: #5f6368;">บาท</span>
                    </div>
                </div>
            </div>
            <div class="option-row">
                <span>👥 จำนวนผู้เข้าร่วม</span>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <input type="number" id="eventCapacity" placeholder="ไม่จำกัด" min="0" style="width: 100px;">
                    <span style="color: var(--text-muted); cursor: pointer;">✎</span>
                </div>
            </div>
        </div>

        <button class="submit-btn" onclick="submitEvent()">
            สร้างกิจกรรม
        </button>
    </div>
</div>
@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script>
            const EnumEventType = { Online: 1, Offline: 2 };
            const EnumEventStatus = { Draft: 1, Published: 2 };
            const EnumJointType = { Public: 1, RequireApproval: 2 };

            let posterDataUrl = null;

            document.addEventListener('DOMContentLoaded', () => {
                const today = new Date().toISOString().split('T')[0];
                document.getElementById('startDate').value = today;
                document.getElementById('endDate').value = today;

                // เรียกใช้งานแผนที่เมื่อโหลดหน้าเว็บเสร็จ
                initMap();
            });

            document.querySelector('.upload-btn').addEventListener('click', () => {
                document.getElementById('posterInput').click();
            });

            document.getElementById('posterInput').addEventListener('change', function () {
                const file = this.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = function (e) {
                    posterDataUrl = e.target.result;
                    const preview = document.querySelector('.poster-preview');
                    let img = preview.querySelector('img.poster-img');
                    if (!img) {
                        img = document.createElement('img');
                        img.className = 'poster-img';
                        img.style.cssText = 'width:100%; height:100%; object-fit:cover; border-radius:inherit; position:absolute; top:0; left:0;';
                        preview.style.position = 'relative';
                        preview.prepend(img);
                    }
                    img.src = posterDataUrl;
                };
                reader.readAsDataURL(file);
            });

            function togglePriceInput() {
                const type = document.getElementById('ticketType').value;
                const priceContainer = document.getElementById('priceInputContainer');
                const priceInput = document.getElementById('ticketPrice');

                if (type === 'paid') {
                    priceContainer.style.display = 'flex';
                    priceInput.focus();
                } else {
                    priceContainer.style.display = 'none';
                    priceInput.value = '';
                }
            }

            // ================= JS สำหรับแผนที่ OpenStreetMap (ฟรี 100%) =================
            let map;
            let marker;

            function initMap() {
                // ค่าเริ่มต้นพิกัด (กรุงเทพมหานคร)
                const defaultLat = 13.7563;
                const defaultLng = 100.5018;

                // สร้างแผนที่และตั้งค่ามุมมองเริ่มต้น
                map = L.map('map').setView([defaultLat, defaultLng], 13);

                // ดึงภาพแผนที่จาก OpenStreetMap
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                }).addTo(map);

                // สร้างหมุด (Marker) แบบให้ลากได้
                marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

                // อีเวนต์เมื่อผู้ใช้ลากหมุดเสร็จ
                marker.on('dragend', function (e) {
                    const position = marker.getLatLng();
                    updateLatLngFields(position.lat, position.lng);
                });

                // อีเวนต์เมื่อผู้ใช้คลิกบนแผนที่ (ให้หมุดย้ายตามไปเลย)
                map.on('click', function (e) {
                    marker.setLatLng(e.latlng);
                    updateLatLngFields(e.latlng.lat, e.latlng.lng);
                });
            }

            function updateLatLngFields(lat, lng) {
                document.getElementById("Latitude").value = lat;
                document.getElementById("Longitude").value = lng;
            }

            // ฟังก์ชันค้นหาสถานที่ (ใช้ Nominatim API ฟรีของ OpenStreetMap)
            async function searchOSMLocation() {
                const query = document.getElementById('eventLocation').value;
                if (!query) return;

                // เปลี่ยนข้อความปุ่มเพื่อบอกผู้ใช้ว่ากำลังค้นหา
                const btnSearch = document.getElementById('btnSearchLocation');
                const originalText = btnSearch.innerText;
                btnSearch.innerText = "กำลังหา...";

                try {
                    // เรียก API ค้นหาสถานที่
                    const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`);
                    const data = await response.json();

                    if (data && data.length > 0) {
                        // เจอสถานที่ ดึงค่า Lat/Lng ตัวแรกที่เจอ
                        const lat = parseFloat(data[0].lat);
                        const lon = parseFloat(data[0].lon);

                        // เลื่อนแผนที่ไปจุดนั้นและย้ายหมุด
                        map.setView([lat, lon], 16);
                        marker.setLatLng([lat, lon]);
                        updateLatLngFields(lat, lon);
                    } else {
                        alert('ไม่พบสถานที่ ลองพิมพ์ชื่อให้กว้างขึ้น หรือคลิกเพื่อปักหมุดบนแผนที่เองได้เลยครับ');
                    }
                } catch (error) {
                    console.error('Error searching location:', error);
                    alert('เกิดข้อผิดพลาดในการค้นหา');
                } finally {
                    btnSearch.innerText = originalText;
                }
            }
            // =========================================================================

            function updateLocationPlaceholder() {
                const eventType = document.getElementById('eventType').value;
                const locationInput = document.getElementById('eventLocation');
                const mapContainer = document.getElementById('mapContainer');
                const btnSearch = document.getElementById('btnSearchLocation');

                if (eventType === 'online') {
                    locationInput.placeholder = "เพิ่มลิงก์การประชุม (เช่น Zoom, Google Meet)";
                    mapContainer.style.display = 'none'; // ซ่อนแผนที่
                    btnSearch.style.display = 'none'; // ซ่อนปุ่มค้นหา
                    document.getElementById("Latitude").value = "";
                    document.getElementById("Longitude").value = "";
                } else {
                    locationInput.placeholder = "ค้นหาสถานที่จัดงาน หรือลากหมุดบนแผนที่...";
                    mapContainer.style.display = 'block'; // โชว์แผนที่
                    btnSearch.style.display = 'block'; // โชว์ปุ่มค้นหา

                    // คำสั่งสำคัญของ Leaflet: ให้แผนที่วาดตัวเองใหม่เมื่อสลับกลับมาโชว์
                    if (map) {
                        setTimeout(() => { map.invalidateSize(); }, 100);
                    }
                }
            }

            function submitEvent() {
                const title = document.getElementById('eventTitle').value;
                const info = document.getElementById('eventInfo').value;
                const location = document.getElementById('eventLocation').value;

                const lat = document.getElementById('Latitude').value;
                const lng = document.getElementById('Longitude').value;

                const combinedInfo = location ? `Location: ${location} | Description: ${info}` : info;

                const startDate = document.getElementById('startDate').value;
                const startTime = document.getElementById('startTime').value;
                const endDate = document.getElementById('endDate').value;
                const endTime = document.getElementById('endTime').value;

                const startAtStr = startDate && startTime ? `${startDate}T${startTime}:00` : null;
                const endAtStr = endDate && endTime ? `${endDate}T${endTime}:00` : null;

                const capacityStr = document.getElementById('eventCapacity').value;
                const capacity = capacityStr ? parseInt(capacityStr) : 0;

                const selectedEventType = document.getElementById('eventType').value;
                const eventTypeEnum = selectedEventType === 'online' ? EnumEventType.Online : EnumEventType.Offline;

                const isFree = document.getElementById('ticketType').value === 'free';
                const ticketPrice = isFree ? 0 : (parseFloat(document.getElementById('ticketPrice').value) || 0);

                const categoryId = parseInt(document.querySelector('.eventCategorySelect').value);

                const eventToCreate = {
                    title: title,
                    info: combinedInfo,
                    location: location,
                    latitude: lat ? parseFloat(lat) : null,
                    longitude: lng ? parseFloat(lng) : null,
                    eventType: eventTypeEnum,
                    eventStatus: EnumEventStatus.Published,
                    jointType: EnumJointType.Public,
                    capacity: capacity,
                    categoryId: categoryId,
                    posterUrl: posterDataUrl,
                    startAt: startAtStr,
                    endAt: endAtStr
                };

                // 

                if (!eventToCreate.title) {
                    alert("❌ กรุณากรอกชื่อกิจกรรม");
                    return;
                }

                if (!categoryId) {
                    alert("❌ กรุณาเลือกหมวดหมู่กิจกรรม");
                    return;
                }

                if (!eventToCreate.location) {
                    alert("❌ กรุณากรอกสถานที่");
                    return;
                }

                $.ajax({
                    url: '/Event/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    dataType: "json",
                    data: JSON.stringify(eventToCreate),
                    headers: {
                        // Reads token from a hidden input usually generated by @Html.AntiForgeryToken()
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (result) {
                        console.log(result);
                    },
                    error: function (xhr, status, error) {
                        console.error(error);
                    }
                });


                console.log("🚀 ข้อมูลที่จะส่ง:", eventToCreate);
                alert("✅ ตรวจสอบข้อมูลสำเร็จ! ดู Payload ได้ใน Console");
            }
    </script>
}