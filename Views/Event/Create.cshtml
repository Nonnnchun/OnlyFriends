@using OnlyFriends.Models.DTOS.EventDTOS
@using OnlyFriends.Models.DTOS.CategoryDTOS
@model CreateEventDTO
@{
    ViewData["Title"] = "Create Activity";
    var categories = (ViewData["Categories"] as IEnumerable<GetCategoryDTO>)?.ToList() ?? new List<GetCategoryDTO>();
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
    <style>
        .custom-confirm-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center;
            z-index: 10000; opacity: 0; pointer-events: none; transition: 0.3s;
        }
        .custom-confirm-overlay.show { opacity: 1; pointer-events: auto; }
        .custom-confirm-box {
            background: white; padding: 24px; border-radius: 12px;
            width: 320px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transform: translateY(-20px); transition: 0.3s;
        }
        .custom-confirm-overlay.show .custom-confirm-box { transform: translateY(0); }
        .confirm-btn-group { display: flex; gap: 10px; margin-top: 20px; }
        .confirm-btn { flex: 1; padding: 10px; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; }
        .confirm-yes { background: #111; color: white; }
        .confirm-no { background: #f1f3f5; color: #111; }
    </style>
}

<div class="create-container">
    @if (!(User?.Identity?.IsAuthenticated ?? false))
    {
        <div class="register-modal-backdrop" id="authRequiredModal" style="position:fixed; inset:0; background:rgba(0,0,0,0.5); display:flex; align-items:center; justify-content:center; z-index:9999;">
            <div class="register-modal" style="background:#fff; border-radius:14px; padding:24px; max-width:360px; text-align:center; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
                <div style="font-size:1.2rem; font-weight:700; margin-bottom:10px;">Please sign in</div>
                <div style="color:#555; margin-bottom:20px;">You need to sign in before creating an activity.</div>
                <button onclick="window.location.href='/login'" style="background:#111; color:#fff; border:none; padding:10px 20px; border-radius:99px; cursor:pointer;">Go to Login</button>
            </div>
        </div>
        <style>body { overflow: hidden; }</style>
    }
    <div class="left-col">
        <div class="poster-upload-box">
            <div class="poster-preview" id="posterPreviewBox" style="text-align: center; color: #888; width: 320px; height: 350px; display: flex; flex-direction: column; justify-content: center; align-items: center; background: #f8f9fa;">
                <i class="fa-regular fa-image" style="font-size: 3.5rem; color: #adb5bd; margin-bottom: 12px;"></i>
                <div style="font-size: 0.95rem; font-weight: 500; color: #6c757d;">Click to upload an image</div>
                <div style="font-size: 0.75rem; color: #adb5bd; margin-top: 4px;">Supports JPG, PNG (1:1 ratio)</div>
            </div>
            <input type="file" id="posterInput" style="display: none;" accept="image/*">
            <button type="button"
                    id="removePosterBtn"
                    onclick="removePoster(event)"
                    style="display:none; margin-top:10px; width:320px; padding:10px 12px; border:1px solid #ced4da; border-radius:8px; background:#fff; color:#dc3545; font-weight:600; cursor:pointer;">
                Remove uploaded image
            </button>
        </div>
    </div>

    <div class="right-col">
        <div class="top-actions" style="text-align: right; margin-bottom: 10px;">
            <select class="dropdown-badge custom-select" id="eventVisibility">
                <option value="Public">Public</option>
                <option value="Private">Private</option>
            </select>
        </div>

        <input type="text" id="eventTitle" class="title-input" placeholder="Event title">

        <div class="schedule-wrapper">
            <div class="datetime-block">
                <div class="timeline-line"></div>

                <div class="dt-row">
                    <div class="dt-label">
                        <div class="dot-solid"></div>
                        Start
                    </div>
                    <div class="dt-input-group">
                        <input type="date" id="startDate" class="flatpickr-date">
                        <select id="startTime" class="time-select"></select>
                    </div>
                </div>

                <div class="dt-row">
                    <div class="dt-label">
                        <div class="dot-outline"></div>
                        End
                    </div>
                    <div class="dt-input-group">
                        <input type="date" id="endDate" class="flatpickr-date">
                        <select id="endTime" class="time-select"></select>
                    </div>
                </div>

            </div>

            <div class="timezone-block">
                <div style="color: #9aa0a6; font-size: 1.2rem; margin-bottom: 5px;">🌐</div>
                <select id="eventTimeZone" class="custom-select" style="border:none; outline:none; font-weight:bold; cursor:pointer; background:transparent; width: 100%; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; max-width: 140px;">
                    <option value="GMT-12:00">(GMT-12:00) International Date Line West</option>
                    <option value="GMT-11:00">(GMT-11:00) Midway Island, Samoa</option>
                    <option value="GMT-10:00">(GMT-10:00) Hawaii</option>
                    <option value="GMT-09:00">(GMT-09:00) Alaska</option>
                    <option value="GMT-08:00">(GMT-08:00) Pacific Time</option>
                    <option value="GMT-07:00">(GMT-07:00) Mountain Time</option>
                    <option value="GMT-06:00">(GMT-06:00) Central Time</option>
                    <option value="GMT-05:00">(GMT-05:00) Eastern Time</option>
                    <option value="GMT-04:00">(GMT-04:00) Atlantic Time</option>
                    <option value="GMT-03:00">(GMT-03:00) Buenos Aires</option>
                    <option value="GMT-02:00">(GMT-02:00) Mid-Atlantic</option>
                    <option value="GMT-01:00">(GMT-01:00) Azores</option>
                    <option value="GMT+00:00">(GMT+00:00) London</option>
                    <option value="GMT+01:00">(GMT+01:00) Paris, Berlin</option>
                    <option value="GMT+02:00">(GMT+02:00) Athens</option>
                    <option value="GMT+03:00">(GMT+03:00) Moscow</option>
                    <option value="GMT+04:00">(GMT+04:00) Abu Dhabi</option>
                    <option value="GMT+05:00">(GMT+05:00) Islamabad</option>
                    <option value="GMT+05:30">(GMT+05:30) New Delhi</option>
                    <option value="GMT+06:00">(GMT+06:00) Almaty</option>
                    <option value="GMT+07:00" selected>(GMT+07:00) Bangkok</option>
                    <option value="GMT+08:00">(GMT+08:00) Beijing</option>
                    <option value="GMT+09:00">(GMT+09:00) Tokyo</option>
                    <option value="GMT+10:00">(GMT+10:00) Sydney</option>
                    <option value="GMT+11:00">(GMT+11:00) Solomon Is.</option>
                    <option value="GMT+12:00">(GMT+12:00) Auckland</option>
                </select>
            </div>
        </div>

        <div class="input-group" style="display:flex; gap:10px; align-items:center;">
            <span>⏳</span>
            <span style="min-width:170px; color:#495057; font-weight:600;">Registration Deadline</span>
            <div style="display:flex; gap:10px; flex:1;">
                <input type="date" id="registrationDeadlineDate" class="flatpickr-date" style="flex:1;">
                <select id="registrationDeadlineTime" class="time-select" style="flex:1;"></select>
            </div>
        </div>

        <div class="input-group" style="display: flex; gap: 10px; align-items: center; position: relative;">
            <span>📍</span>
            <input type="text" id="eventLocation" placeholder="Search event location here..." style="flex: 1; border: none; outline: none; background: transparent; padding: 10px 0;" autocomplete="off">
            <div id="searchDropdown" style="display: none; position: absolute; top: calc(100% + 5px); left: 0; right: 0; background: white; border: 1px solid #ced4da; border-radius: 8px; z-index: 1000; max-height: 250px; overflow-y: auto; box-shadow: 0 8px 16px rgba(0,0,0,0.1);"></div>
        </div>

        <input type="hidden" id="Latitude" name="Latitude">
        <input type="hidden" id="Longitude" name="Longitude">

        <div id="mapContainer" style="width: 100%; height: 300px; border-radius: 12px; margin-bottom: 15px; border: 1px solid #ced4da; overflow: hidden; display: block; z-index: 1;">
            <div id="leafletMap" style="width: 100%; height: 100%;"></div>
        </div>
        <div class="input-group">
            <span>📝</span>
            <input type="text" id="eventInfo" placeholder="Add description">
        </div>
        <div class="input-group" style="flex-direction: column; align-items: stretch; gap: 10px;">
            <span>🏷️ Activity categories</span>
            <div id="categoryContainer" class="category-pills-wrap">
                @foreach (var category in categories)
                {
                    <button type="button"
                            class="create-category-pill"
                            data-cat-name="@category.CategoryName"
                            onclick="toggleCreateCategoryPill(this)">
                        <span class="create-pill-check">✓</span>
                        @category.CategoryName
                    </button>
                }
            </div>
        </div>
        <div class="section-title">Activity options</div>
        <div class="form-section">
            <div class="option-row">
                <span>💻 Event format</span>
                <select id="eventType" onchange="updateLocationPlaceholder()" style="border: none; background: transparent; color: var(--primary-color); font-weight: bold; cursor: pointer; outline: none; text-align: right;">
                    <option value="offline">Offline (On-site)</option>
                    <option value="online">Online (Virtual)</option>
                </select>
            </div>

            <div class="option-row">
                <span>👥 Participant limit</span>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <input type="number" id="eventCapacity" placeholder="Unlimited" min="0" style="width: 100px;" 
                           onkeydown="if(event.key === '-' || event.key === 'e') event.preventDefault();"
                           oninput="if(this.value < 0) this.value = Math.abs(this.value);" autocomplete="off">
                    <span style="color: var(--text-muted); cursor: pointer;">✎</span>
                </div>
            </div>
        </div>

        <button class="submit-btn" onclick="submitEvent()">
            Create Activity
        </button>
    </div>
</div>

<div class="custom-confirm-overlay" id="submitConfirmModal">
    <div class="custom-confirm-box">
        <h3 style="margin-top:0; margin-bottom:10px; font-size:1.2rem;">Confirm activity creation</h3>
        <p style="color:#555; font-size:0.95rem; margin-bottom:0;">Do you want to create this activity?</p>
        <div class="confirm-btn-group">
            <button class="confirm-btn confirm-no" onclick="closeConfirmModal()">Cancel</button>
            <button class="confirm-btn confirm-yes" id="btnConfirmPublish" onclick="executeSubmit()">Create now</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        const EnumEventType = { Online: 0, Offline: 1 };
        const EnumEventStatus = { Open: 0, Closed: 1 };
        const EnumJointType = { Private: 0, Public: 1 };
        const defaultLat = 13.7563;
        const defaultLng = 100.5018;

        let posterDataUrl = null;

        function parseDateTime(dateValue, timeValue) {
            if (!dateValue || !timeValue) return null;
            return new Date(`${dateValue}T${timeValue}:00`);
        }

        function validateRegistrationDeadlineRange(showAlert = false) {
            const startDate = document.getElementById('startDate')?.value;
            const startTime = document.getElementById('startTime')?.value;
            const deadlineDate = document.getElementById('registrationDeadlineDate')?.value;
            const deadlineTime = document.getElementById('registrationDeadlineTime')?.value;
            const deadlineDateInput = document.getElementById('registrationDeadlineDate');

            if (deadlineDateInput) {
                deadlineDateInput.min = new Date().toISOString().split('T')[0];
                deadlineDateInput.max = startDate || '';
            }

            if (!deadlineDate || !deadlineTime || !startDate || !startTime) {
                return true;
            }

            const now = new Date();
            const startAt = parseDateTime(startDate, startTime);
            const deadlineAt = parseDateTime(deadlineDate, deadlineTime);

            if (!startAt || !deadlineAt) return true;

            if (deadlineAt < now) {
                if (showAlert) alert("❌ Registration deadline must be from now onward");
                return false;
            }

            if (deadlineAt > startAt) {
                if (showAlert) alert("❌ Registration deadline must be before or equal to Start time");
                return false;
            }

            return true;
        }

        function setRemovePosterButtonVisible(isVisible) {
            const btn = document.getElementById('removePosterBtn');
            if (btn) btn.style.display = isVisible ? 'block' : 'none';
        }

        function removePoster(event) {
            event?.stopPropagation();
            posterDataUrl = null;
            const input = document.getElementById('posterInput');
            if (input) input.value = '';
            const preview = document.getElementById('posterPreviewBox');
            const posterImg = preview?.querySelector('img.poster-img');
            if (posterImg) posterImg.remove();
            setRemovePosterButtonVisible(false);
        }

        document.addEventListener('DOMContentLoaded', () => {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('startDate').value = today;
            document.getElementById('endDate').value = today;
            document.getElementById('registrationDeadlineDate').value = today;

            initMap();
            updateLocationPlaceholder();

            flatpickr(".flatpickr-date", {
                dateFormat: "Y-m-d",
                minDate: "today",
            });

            // Populate time dropdowns
            function generateTimeOptions() {
                const times = [];
                for (let h = 0; h < 24; h++) {
                    for (let m = 0; m < 60; m += 15) {
                        const period = h < 12 ? 'am' : 'pm';
                        const displayH = h === 0 ? 12 : (h > 12 ? h - 12 : h);
                        const displayM = m === 0 ? '00' : m;
                        times.push({
                            text: `${displayH}:${displayM}${period}`,
                            value: `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}`
                        });
                    }
                }
                return times;
            }

            const timeOptions = generateTimeOptions();
            let timeHtml = '';
            timeOptions.forEach(t => {
                timeHtml += `<option value="${t.value}">${t.text}</option>`;
            });

            const startSelect = document.getElementById('startTime');
            const endSelect = document.getElementById('endTime');
            const registrationDeadlineSelect = document.getElementById('registrationDeadlineTime');
            startSelect.innerHTML = timeHtml;
            endSelect.innerHTML = timeHtml;
            registrationDeadlineSelect.innerHTML = timeHtml;

            startSelect.value = "16:30";
            endSelect.value = "17:30";
            registrationDeadlineSelect.value = "15:30";

            document.getElementById('startDate')?.addEventListener('change', () => validateRegistrationDeadlineRange(false));
            document.getElementById('startTime')?.addEventListener('change', () => validateRegistrationDeadlineRange(false));
            document.getElementById('registrationDeadlineDate')?.addEventListener('change', () => validateRegistrationDeadlineRange(false));
            document.getElementById('registrationDeadlineTime')?.addEventListener('change', () => validateRegistrationDeadlineRange(false));
            validateRegistrationDeadlineRange(false);

            // Bind click to the whole box instead of the small generic button
            document.getElementById('posterPreviewBox').closest('.poster-upload-box').addEventListener('click', () => {
                document.getElementById('posterInput').click();
            });
        });

        document.getElementById('posterInput').addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                posterDataUrl = e.target.result;
                const preview = document.querySelector('.poster-preview');
                let img = preview.querySelector('img.poster-img');
                if (!img) {
                    img = document.createElement('img');
                    img.className = 'poster-img';
                    img.style.cssText = 'width:100%; height:100%; object-fit:cover; border-radius:inherit; position:absolute; top:0; left:0;';
                    preview.style.position = 'relative';
                    preview.prepend(img);
                }
                img.src = posterDataUrl;
                setRemovePosterButtonVisible(true);
            };
            reader.readAsDataURL(file);
        });

        function togglePriceInput() {
            // function removed
        }

        let map;
        let marker;

        function initMap() {
            map = L.map('leafletMap').setView([defaultLat, defaultLng], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

            marker.on('dragend', function(e) {
                const position = marker.getLatLng();
                updateLatLngFields(position.lat, position.lng);
            });

            map.on('click', function(e) {
                marker.setLatLng(e.latlng);
                updateLatLngFields(e.latlng.lat, e.latlng.lng);
            });

            setTimeout(() => { map.invalidateSize(); }, 200);
            updateLatLngFields(defaultLat, defaultLng);
        }

        function setMapLocation(lat, lng) {
            if (map && marker) {
                const newLatLng = new L.LatLng(lat, lng);
                map.setView(newLatLng, 15);
                marker.setLatLng(newLatLng);
            }
        }

        function updateLatLngFields(lat, lng) {
            document.getElementById("Latitude").value = lat;
            document.getElementById("Longitude").value = lng;
        }

        let searchTimeout;
        document.getElementById('eventLocation').addEventListener('input', function(e) {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                searchOSMLocation();
            }, 600);
        });

        async function searchOSMLocation() {
            const query = document.getElementById('eventLocation').value;
            if (!query || query.length < 3) {
                document.getElementById('searchDropdown').style.display = 'none';
                return;
            }

            const dropdown = document.getElementById('searchDropdown');
            dropdown.innerHTML = '<div style="padding: 10px; color: #666;">Searching...</div>';
            dropdown.style.display = 'block';

            try {
                const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`);
                const data = await response.json(); // Added this line to parse JSON response
                if (data && data.length > 0) {
                    dropdown.innerHTML = '';
                    data.forEach(item => {
                        const div = document.createElement('div');
                        div.style.padding = '10px 14px';
                        div.style.cursor = 'pointer';
                        div.style.borderBottom = '1px solid #f1f3f5';
                        div.innerText = item.display_name;
                        div.onmouseover = () => div.style.backgroundColor = '#f8f9fa';
                        div.onmouseout = () => div.style.backgroundColor = 'white';
                        div.onclick = () => {
                            document.getElementById('eventLocation').value = item.display_name;
                            const lat = parseFloat(item.lat);
                            const lon = parseFloat(item.lon);
                            setMapLocation(lat, lon);
                            updateLatLngFields(lat, lon);
                            dropdown.style.display = 'none';
                        };
                        dropdown.appendChild(div);
                    });
                    dropdown.style.display = 'block';
                } else {
                    dropdown.innerHTML = '<div style="padding: 10px; color: #666;">No places found. Try a broader keyword.</div>';
                }
            } catch (error) {
                console.error('Error searching location:', error);
                dropdown.innerHTML = '<div style="padding: 10px; color: #d9534f;">Search failed.</div>';
            }
        }

        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('searchDropdown');
            const input = document.getElementById('eventLocation');
            if (dropdown && e.target !== dropdown && e.target !== input && !dropdown.contains(e.target)) {
                dropdown.style.display = 'none';
            }
        });

        function updateLocationPlaceholder() {
            const eventType = document.getElementById('eventType').value;
            const locationInput = document.getElementById('eventLocation');
            const mapContainer = document.getElementById('mapContainer');
            const btnSearch = document.getElementById('btnSearchLocation'); // This element does not exist in the provided HTML

            if (eventType === 'online') {
                locationInput.placeholder = "Add meeting link (e.g. Zoom, Google Meet)";
                mapContainer.style.display = 'none';
                if (btnSearch) btnSearch.style.display = 'none'; // Check if btnSearch exists before accessing style
                document.getElementById("Latitude").value = "";
                document.getElementById("Longitude").value = "";
            } else {
                locationInput.placeholder = "Search event location...";
                mapContainer.style.display = 'block';
                if (btnSearch) btnSearch.style.display = 'block'; // Check if btnSearch exists before accessing style
            }
        }

        let eventToSubmit = null;

        function toggleCreateCategoryPill(btn) {
            btn.classList.toggle('selected');
        }

        // Legacy stubs (no longer used)
        function createCategoryRow() {}
        function refreshCategoryRowButtons() {}
        function onCategoryRowAction() {}

        function submitEvent() {
            const title = document.getElementById('eventTitle').value;
            const info = document.getElementById('eventInfo').value;
            const location = document.getElementById('eventLocation').value;

            const visibilityStr = document.getElementById('eventVisibility').value;
            const jointType = EnumJointType[visibilityStr] ?? EnumJointType.Public;
            const lat = document.getElementById('Latitude').value;
            const lng = document.getElementById('Longitude').value;

            const combinedInfo = location ? `Location: ${location} | Description: ${info}` : info;

            const startDate = document.getElementById('startDate').value;
            const startTime = document.getElementById('startTime').value;
            const endDate = document.getElementById('endDate').value;
            const endTime = document.getElementById('endTime').value;
            const timeZone = document.getElementById('eventTimeZone').value;
            const registrationDeadlineDate = document.getElementById('registrationDeadlineDate').value;
            const registrationDeadlineTime = document.getElementById('registrationDeadlineTime').value;

            const startAtStr = startDate && startTime ? `${startDate}T${startTime}:00` : null;
            const endAtStr = endDate && endTime ? `${endDate}T${endTime}:00` : null;
            const hasRegistrationDate = Boolean(registrationDeadlineDate);
            const hasRegistrationTime = Boolean(registrationDeadlineTime);
            if (hasRegistrationDate !== hasRegistrationTime) {
                alert("❌ Please select both date and time for registration deadline");
                return;
            }
            const registrationDeadlineStr = (hasRegistrationDate && hasRegistrationTime)
                ? `${registrationDeadlineDate}T${registrationDeadlineTime}:00`
                : null;

            const capacityStr = document.getElementById('eventCapacity').value;
            const capacity = capacityStr ? parseInt(capacityStr) : 0;

            const selectedEventType = document.getElementById('eventType').value;
            const eventTypeEnum = selectedEventType === 'online' ? EnumEventType.Online : EnumEventType.Offline;

            const categoryNames = [...document.querySelectorAll('#categoryContainer .create-category-pill.selected')]
                .map(btn => String(btn.dataset.catName || '').trim())
                .filter(Boolean);
            const uniqueCategoryNames = [...new Set(categoryNames)];

            if (!title) { alert("❌ Please enter an event title"); return; }
            if (!uniqueCategoryNames.length) { alert("❌ Please select at least one activity category"); return; }
            if (!location && eventTypeEnum === EnumEventType.Offline) { alert("❌ Please enter a location"); return; }

            if (startDate && endDate && startTime && endTime) {
                const startFull = new Date(`${startDate}T${startTime}:00`);
                const endFull = new Date(`${endDate}T${endTime}:00`);
                const now = new Date();
                now.setHours(0,0,0,0);
                
                const startOnlyDate = new Date(`${startDate}T00:00:00`);
                if (startOnlyDate < now) {
                    alert("❌ Start date cannot be in the past");
                    return;
                }
                
                const diffMins = (endFull.getTime() - startFull.getTime()) / 60000;
                if (diffMins < 30) {
                    alert("❌ Event duration must be at least 30 minutes");
                    return;
                }

                if (registrationDeadlineStr) {
                    const deadlineFull = new Date(registrationDeadlineStr);
                    if (deadlineFull < new Date()) {
                        alert("❌ Registration deadline cannot be in the past");
                        return;
                    }
                    if (startAtStr && deadlineFull > new Date(startAtStr)) {
                        alert("❌ Registration deadline cannot be after the event starts");
                        return;
                    }
                }
            }

            if (!validateRegistrationDeadlineRange(true)) {
                return;
            }

            eventToSubmit = {
                title: title,
                info: combinedInfo,
                location: location,
                latitude: lat ? parseFloat(lat) : null,
                longitude: lng ? parseFloat(lng) : null,
                eventType: eventTypeEnum,
                eventStatus: EnumEventStatus.Open,
                jointType: jointType,
                capacity: capacity,
                categoryNames: uniqueCategoryNames,
                posterUrl: typeof posterDataUrl !== 'undefined' ? posterDataUrl : null,
                startAt: startAtStr,
                endAt: endAtStr,
                registrationDeadline: registrationDeadlineStr,
                timeZone: timeZone
            };

            document.getElementById('submitConfirmModal').classList.add('show');
        }

        function closeConfirmModal() {
            document.getElementById('submitConfirmModal').classList.remove('show');
        }

        function executeSubmit() {
            if (!eventToSubmit) return;
            const btnConfirm = document.getElementById('btnConfirmPublish');
            btnConfirm.disabled = true;
            btnConfirm.innerText = "Creating...";

            $.ajax({
                url: '/Event/Create',
                type: 'POST',
                contentType: 'application/json',
                dataType: "json",
                data: JSON.stringify(eventToSubmit),
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (result) {
                    if (result && result.success) {
                        alert('✅ Activity created successfully!');
                        window.location.href = '/Home/Homepage';
                    } else if (result.redirectUrl) {
                        window.location.href = result.redirectUrl;
                    } else {
                        alert('✅ Activity created successfully!');
                        window.location.href = '/Home/Homepage';
                    }
                },
                error: function (xhr, status, error) {
                    alert('❌ Error: ' + (xhr.responseText || error));
                },
                complete: function () {
                    closeConfirmModal();
                    btnConfirm.disabled = false;
                    btnConfirm.innerText = "Create now";
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            refreshCategoryRowButtons();
        });
    </script>
}
