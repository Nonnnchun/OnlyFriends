@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlyFriends</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/OnlyFriends.styles.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    @RenderSection("Styles", required: false)
</head>

<body>
    @{
        var uname = (User?.Identity?.Name
                    ?? User?.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                    ?? User?.FindFirst("unique_name")?.Value
                    ?? "").Trim();
        var currentUserIdClaim = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var profileSlug = string.IsNullOrEmpty(uname) ? "" : "@" + uname;
        var picture = User?.FindFirst("picture")?.Value;
        var avatarUrl = !string.IsNullOrWhiteSpace(picture)
            ? picture
            : (!string.IsNullOrEmpty(uname)
                ? $"https://ui-avatars.com/api/?background=f0f2f5&color=111&name={Uri.EscapeDataString(uname)}"
                : "https://ui-avatars.com/api/?background=f0f2f5&color=111&name=U");
    }
    <header class="app-header">
        <nav class="custom-navbar">
            <div class="nav-left">
                <a href="/" class="of-brand-logo">
                    <div class="of-logo-icon">OF</div>
                    <div class="of-logo-text">Only<span>Friends</span></div>
                </a>
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-controller="Home" asp-action="Homepage" class="nav-link" style="color:#555; text-decoration:none; font-weight:500;">Home</a>
                }
            </div>
            <div class="nav-right">
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-controller="Event" asp-action="Create" class="nav-link" style="color:#555; text-decoration:none; font-weight:500;">Create Activity</a>
                    <div class="dropdown" id="filterDropdown">
                        <button class="nav-btn" onclick="toggleFilter()" style="display:flex; align-items:center; gap:8px; background:#fff; border:1px solid #ced4da; padding:6px 16px; border-radius:99px; color:#212529; font-weight:600; cursor:pointer; font-size:0.95rem; box-shadow:0 1px 2px rgba(0,0,0,0.05);">
                            <i class="fa-solid fa-filter"></i> กรองเนื้อหา
                        </button>
                        <div class="dropdown-content" id="filterMenu" style="width:280px; padding:15px; border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,0.1); border:1px solid #eee;">
                            <div style="font-weight:700; margin-bottom:12px; font-size:1.1rem;">หมวดหมู่กิจกรรม</div>
                            <div class="filter-item" style="padding:8px 0; border-bottom:1px solid #f1f3f5;">
                                <label style="display:flex; align-items:center; cursor:pointer; gap:10px; margin:0; width:100%;">
                                    <input type="checkbox" id="catSports" style="width:16px; height:16px;"> เกมส์
                                </label>
                            </div>
                            <div class="filter-item" style="padding:8px 0; border-bottom:1px solid #f1f3f5;">
                                <label style="display:flex; align-items:center; cursor:pointer; gap:10px; margin:0; width:100%;">
                                    <input type="checkbox" id="catEdu" style="width:16px; height:16px;"> ท่องเที่ยว
                                </label>
                            </div>
                            <button class="btn-apply" onclick="applyFilter()" style="width:100%; margin-top:15px; background:#111; color:#fff; border:none; padding:10px; border-radius:8px; font-weight:600; cursor:pointer;">นำไปใช้</button>
                        </div>
                    </div>

                    @await Html.PartialAsync("_NotificationBell")
                    <div class="dropdown" id="profileDropdown">
                        <button class="profile-btn" onclick="toggleProfile()">
                            <img src="@avatarUrl" alt="Profile">
                        </button>
                        <div class="dropdown-content profile-menu" id="profileMenu">
                            @if (!string.IsNullOrEmpty(uname))
                            {
                                <a href="/user/@profileSlug" data-my-profile id="myProfileLink">โปรไฟล์ของฉัน</a>
                            }
                            else
                            {
                                <a href="/login" data-my-profile id="myProfileLink">โปรไฟล์ของฉัน</a>
                            }
                            <a href="/setting">การตั้งค่า</a>
                            <hr>
                            <form method="post" action="/login/logout">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-link">ออกจากระบบ</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/Home/Homepage" class="nav-link" style="color:#555; text-decoration:none; font-weight:500;">Explore Events <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                    <a href="@Url.Action("Index", "Login")" class="sign-in-link">Sign In</a>
                }
            </div>
        </nav>
    </header>
    <div class="app-shell">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="app-footer">
            <div class="app-footer-inner">
                <div class="app-footer-left">
                    <div class="app-footer-brand">OnlyFriends</div>
                    <p class="app-footer-text">
                        จัดกิจกรรม นัดพบ และค้นหาเพื่อนใหม่ได้ในที่เดียว
                    </p>
                </div>
                <div class="app-footer-links">
                    <div class="app-footer-column">
                        <div class="app-footer-title">โปรไฟล์ของฉัน</div>
                        @if (((User?.Identity?.IsAuthenticated) ?? false) && !string.IsNullOrEmpty(uname))
                        {
                            <a href="/user/@profileSlug">ดูโปรไฟล์</a>
                        }
                        else
                        {
                            <a href="/login">เข้าสู่ระบบ</a>
                        }
                        <a href="/setting">การตั้งค่า</a>
                    </div>
                    <div class="app-footer-column">
                        <div class="app-footer-title">ข้อมูล</div>
                        <a asp-controller="Home" asp-action="Privacy">ความเป็นส่วนตัว</a>
                        <span class="app-footer-badge">โครงการตัวอย่าง</span>
                    </div>
                </div>
            </div>
            <div class="app-footer-bottom">
                <span>© @DateTime.Now.Year OnlyFriends</span>
                <span class="app-footer-meta">สร้างเพื่อการเรียนรู้และทดลองใช้งาน</span>
            </div>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>