@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In – OnlyFriends</title>
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="~/OnlyFriends.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: #f0f4f8;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── Shared page-slide transition ── */
        .auth-page { animation: auth-fade-in 0.32s cubic-bezier(.4,0,.2,1) both; }
        @@keyframes auth-fade-in {
            from { opacity: 0; transform: translateX(24px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        .auth-page.is-leaving { animation: auth-fade-out 0.28s cubic-bezier(.4,0,.2,1) both; }
        @@keyframes auth-fade-out {
            from { opacity: 1; transform: translateX(0); }
            to   { opacity: 0; transform: translateX(-24px); }
        }

        /* ── Navbar ── */
        .auth-nav {
            display: flex; justify-content: space-between; align-items: center;
            padding: 0 36px; height: 64px;
            background: rgba(255,255,255,0.95); backdrop-filter: blur(12px);
            border-bottom: 1px solid #e8edf5; position: sticky; top: 0; z-index: 10;
        }
        .auth-nav-right { display: flex; align-items: center; gap: 20px; }
        .auth-nav-explore {
            font-size: 13px; font-weight: 500; color: #555; text-decoration: none;
            display: inline-flex; align-items: center; gap: 6px;
            transition: color 0.15s;
        }
        .auth-nav-explore:hover { color: #00AFF0; }
        .auth-nav-cta {
            font-size: 13px; font-weight: 600; padding: 8px 18px;
            border-radius: 99px; border: 1.5px solid #0f1523; color: #0f1523;
            text-decoration: none; transition: background 0.15s, color 0.15s;
        }
        .auth-nav-cta:hover { background: #0f1523; color: #fff; }
        .auth-nav-toggle {
            display: none;
            align-items: center; justify-content: center;
            width: 38px; height: 38px;
            border: 1px solid #d9dde4; border-radius: 10px;
            background: #fff; color: #374151;
            cursor: pointer; padding: 0; margin: 0;
            font-size: 18px; flex: 0 0 auto;
        }
        .auth-nav-toggle .fa-xmark { display: none; }
        .auth-nav.mobile-open .auth-nav-toggle .fa-bars { display: none; }
        .auth-nav.mobile-open .auth-nav-toggle .fa-xmark { display: inline-block; }

        /* ── Split layout ── */
        .auth-shell {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 480px;
            min-height: calc(100vh - 64px);
        }

        /* ── Left decorative panel ── */
        .auth-panel {
            background:
                radial-gradient(ellipse 800px 600px at 80% -10%, rgba(0,175,240,0.18) 0%, transparent 55%),
                radial-gradient(ellipse 600px 500px at -10% 110%, rgba(124,58,237,0.10) 0%, transparent 55%),
                linear-gradient(160deg, #f0f7ff 0%, #eef2ff 60%, #f5f0ff 100%);
            display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
            padding: 60px 64px; overflow: hidden; position: relative;
        }
        .auth-panel::before {
            content: '';
            position: absolute; inset: 0;
            background: none;
        }
        .auth-panel-brand {
            position: relative; z-index: 1;
            display: inline-flex; align-items: center; gap: 10px;
            margin-bottom: 52px; text-decoration: none;
        }
        .auth-panel-logo-icon {
            width: 40px; height: 40px; border-radius: 10px;
            background: linear-gradient(135deg, #00AFF0, #0077b6);
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 14px; color: #fff; letter-spacing: -0.5px;
        }
        .auth-panel-logo-text {
            font-size: 22px; font-weight: 800; color: #0f1523; letter-spacing: -0.04em;
        }
        .auth-panel-logo-text span { color: #00AFF0; }

        .auth-panel-headline {
            position: relative; z-index: 1;
            font-size: clamp(1.8rem, 2.4vw, 2.6rem);
            font-weight: 900; color: #0f1523; letter-spacing: -0.04em; line-height: 1.18;
            margin-bottom: 16px;
        }
        .auth-panel-headline em {
            font-style: normal;
            background: linear-gradient(125deg, #00AFF0, #7c3aed 70%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .auth-panel-sub {
            position: relative; z-index: 1;
            font-size: 14px; color: #4b5563; line-height: 1.7; max-width: 36ch;
            margin-bottom: 40px;
        }
        .auth-panel-pills {
            position: relative; z-index: 1;
            display: flex; flex-wrap: wrap; gap: 8px;
        }
        .auth-pill {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 14px; border-radius: 99px;
            background: rgba(255,255,255,0.75); border: 1px solid rgba(0,175,240,0.25);
            font-size: 12px; font-weight: 600; color: #374151;
            backdrop-filter: blur(4px);
        }
        .auth-pill i { font-size: 11px; color: #00AFF0; }

        /* ── Right form panel ── */
        .auth-form-panel {
            background: #fff;
            display: flex; flex-direction: column; justify-content: center;
            padding: 60px 52px;
            position: relative;
        }

        .auth-form-inner {
            width: 100%; max-width: 360px; margin: 0 auto;
        }

        .auth-form-title {
            font-size: 1.75rem; font-weight: 800; color: #0f1523; letter-spacing: -0.035em;
            margin-bottom: 6px;
        }
        .auth-form-sub {
            font-size: 14px; color: #6b7280; margin-bottom: 32px; line-height: 1.5;
        }

        /* Fields */
        .auth-input-group { margin-bottom: 18px; }
        .auth-input-group label {
            display: block; font-size: 13px; font-weight: 600; color: #374151;
            margin-bottom: 6px;
        }
        .auth-input-group input {
            width: 100%; padding: 11px 14px; border-radius: 10px;
            border: 1.5px solid #e5e7eb; background: #f9fafb;
            font-size: 14px; font-family: 'Inter', system-ui, sans-serif;
            color: #0f1523; transition: border-color 0.15s, background 0.15s;
            outline: none;
        }
        .auth-input-group input:focus {
            border-color: #00AFF0; background: #fff;
            box-shadow: 0 0 0 3px rgba(0,175,240,0.12);
        }
        .auth-input-group input::placeholder { color: #9ca3af; }

        .auth-input-wrap { position: relative; }
        .auth-input-wrap input { padding-right: 44px; }
        .auth-toggle-eye {
            position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
            background: none; border: none; cursor: pointer; color: #9ca3af; font-size: 15px;
            transition: color 0.15s; padding: 4px;
        }
        .auth-toggle-eye:hover { color: #374151; }

        /* Inline grid for name fields */
        .auth-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

        /* Error box */
        .auth-error-box {
            font-size: 13px; color: #dc2626; background: #fff5f5;
            border: 1px solid #fecaca; border-radius: 8px;
            padding: 10px 14px; margin-bottom: 18px;
        }
        .auth-field-error { font-size: 12px; color: #dc2626; margin-top: 4px; }

        /* Submit button */
        .auth-submit {
            width: 100%; padding: 13px; margin-top: 6px;
            background: linear-gradient(90deg, #00AFF0, #0077b6);
            color: #fff; font-size: 15px; font-weight: 700;
            border: none; border-radius: 12px; cursor: pointer; font-family: inherit;
            transition: opacity 0.15s, transform 0.15s, box-shadow 0.15s;
            box-shadow: 0 4px 16px rgba(0,175,240,0.35);
        }
        .auth-submit:hover { opacity: 0.92; transform: translateY(-1px); box-shadow: 0 6px 22px rgba(0,175,240,0.45); }
        .auth-submit:active { opacity: 1; transform: translateY(0); }

        /* Footer link */
        .auth-footer-link {
            text-align: center; margin-top: 24px;
            font-size: 13px; color: #6b7280;
        }
        .auth-footer-link a {
            color: #0f1523; font-weight: 700; text-decoration: none;
            transition: color 0.15s;
        }
        .auth-footer-link a:hover { color: #00AFF0; }

        /* Divider */
        .auth-divider {
            display: flex; align-items: center; gap: 12px; margin: 24px 0;
            font-size: 12px; color: #9ca3af; font-weight: 500;
        }
        .auth-divider::before, .auth-divider::after {
            content: ''; flex: 1; height: 1px; background: #e5e7eb;
        }

        /* Responsive */
        @@media (max-width: 820px) {
            .auth-shell { grid-template-columns: 1fr; }
            .auth-panel { display: none; }
            .auth-form-panel { padding: 40px 28px; }
        }

        @@media (max-width: 640px) {
            .auth-nav {
                height: auto;
                min-height: 64px;
                flex-wrap: wrap;
                row-gap: 0;
                padding: 10px 16px;
            }
            .auth-nav-toggle {
                display: inline-flex;
            }
            .auth-nav-right {
                display: none;
                width: 100%;
                flex-direction: column;
                align-items: stretch;
                gap: 8px;
                margin-top: 10px;
                padding-top: 10px;
                border-top: 1px solid #e8edf5;
            }
            .auth-nav.mobile-open .auth-nav-right {
                display: flex;
            }
            .auth-nav-right .auth-nav-explore,
            .auth-nav-right .auth-nav-cta {
                width: 100%;
                min-height: 40px;
                display: inline-flex;
                align-items: center;
                padding: 0 8px;
            }
            .auth-nav-right .auth-nav-cta {
                justify-content: center;
            }
        }
    </style>
</head>
<body class="auth-page">

    <!-- Navbar -->
    <nav class="auth-nav" id="authNav">
        <a href="/" class="of-brand-logo">
            <div class="of-logo-icon">OF</div>
            <div class="of-logo-text">Only<span>Friends</span></div>
        </a>
        <button type="button"
                class="auth-nav-toggle"
                id="authNavToggle"
                aria-label="Toggle navigation"
                aria-expanded="false"
                aria-controls="authNavMenu">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
        <div class="auth-nav-right" id="authNavMenu">
            <a href="/Home/Homepage" class="auth-nav-explore">
                Explore Events <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
            <a href="/Register" class="auth-nav-cta">Sign Up</a>
        </div>
    </nav>

    <!-- Shell -->
    <div class="auth-shell">

        <!-- Left decorative panel -->
        <div class="auth-panel">
            <a href="/" class="auth-panel-brand">
                <div class="auth-panel-logo-icon">OF</div>
                <div class="auth-panel-logo-text">Only<span>Friends</span></div>
            </a>

            <h2 class="auth-panel-headline">
                Welcome back —<br>
                good to <em>see you again</em>
            </h2>
            <p class="auth-panel-sub">
                Sign in to manage your events, connect with friends, and discover new activities nearby.
            </p>
            <div class="auth-panel-pills">
                <span class="auth-pill"><i class="fa-solid fa-calendar-check"></i> Manage Events</span>
                <span class="auth-pill"><i class="fa-solid fa-user-group"></i> Meet People</span>
                <span class="auth-pill"><i class="fa-solid fa-location-dot"></i> Nearby Activities</span>
            </div>
        </div>

        <!-- Right form panel -->
        <div class="auth-form-panel">
            <div class="auth-form-inner">
                <h1 class="auth-form-title">Sign in</h1>
                <p class="auth-form-sub">Enter your credentials to continue.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-error-box">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form method="post" action="/login" id="loginForm">
                    <div class="auth-input-group">
                        <label for="identifier">Email or Username</label>
                        <input type="text" id="identifier" name="identifier"
                               placeholder="you@email.com or johndoe" required autocomplete="username">
                    </div>

                    <div class="auth-input-group">
                        <label for="password">Password</label>
                        <div class="auth-input-wrap">
                            <input type="password" id="password" name="password"
                                   placeholder="••••••••" required autocomplete="current-password">
                            <button type="button" class="auth-toggle-eye" aria-label="toggle password" data-target="password">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="auth-submit">Sign in</button>
                </form>

                <div class="auth-footer-link">
                    Don't have an account? <a href="/Register" id="goRegister">Create one</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Toggle password visibility
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.auth-toggle-eye');
            if (!btn) return;
            const targetId = btn.getAttribute('data-target');
            const input = document.getElementById(targetId);
            if (!input) return;
            const isPwd = input.type === 'password';
            input.type = isPwd ? 'text' : 'password';
            const icon = btn.querySelector('i');
            icon.classList.toggle('fa-eye', !isPwd);
            icon.classList.toggle('fa-eye-slash', isPwd);
        });

        // Smooth page transition on nav links
        function navigateWithTransition(url) {
            document.body.classList.add('is-leaving');
            setTimeout(() => { window.location.href = url; }, 260);
        }
        document.getElementById('goRegister')?.addEventListener('click', function (e) {
            e.preventDefault();
            navigateWithTransition('/Register');
        });

        (function () {
            const nav = document.getElementById('authNav');
            const toggleBtn = document.getElementById('authNavToggle');
            const menu = document.getElementById('authNavMenu');
            if (!nav || !toggleBtn || !menu) return;

            const mobileQuery = window.matchMedia('(max-width: 640px)');

            function setOpen(open) {
                nav.classList.toggle('mobile-open', open);
                toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
            }

            toggleBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                if (!mobileQuery.matches) return;
                setOpen(!nav.classList.contains('mobile-open'));
            });

            document.addEventListener('click', function (e) {
                if (!mobileQuery.matches) return;
                if (!nav.classList.contains('mobile-open')) return;
                if (!nav.contains(e.target)) {
                    setOpen(false);
                }
            });

            menu.querySelectorAll('a').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (mobileQuery.matches) setOpen(false);
                });
            });

            mobileQuery.addEventListener('change', function (e) {
                if (!e.matches) setOpen(false);
            });
        })();
    </script>
</body>
</html>
