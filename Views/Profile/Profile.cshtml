@model OnlyFriends.Models.DTOS.UserDTOS.GetUserDTO
@using System.Security.Claims
@{
    ViewData["Title"] = "Profile";

    var joinedEvents = ViewBag.JoinedEvents as List<OnlyFriends.Models.Event> ?? new List<OnlyFriends.Models.Event>();
    var friends = ViewBag.Friends as List<OnlyFriends.Models.User> ?? new List<OnlyFriends.Models.User>();

    var hostedCount = Model.CreatedEvents?.Count ?? 0;
    var attendedCount = joinedEvents.Count;
    var username = Model.Username;
    var firstName = Model.FirstName;

    var currentUserId = (int)(ViewData["CurrentUserId"] ?? 0);
    var isOwnProfile = currentUserId != 0 && currentUserId == Model.Id;
    var avatarUrl = string.IsNullOrEmpty(Model.ProfilePictureUrl)
        ? $"https://ui-avatars.com/api/?background=f0f2f5&color=111&name={Uri.EscapeDataString(username)}"
        : Model.ProfilePictureUrl;

    const int PageSize = 5;
}

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #f8f9fa;
        color: #111827;
        font-size: 15px;
        line-height: 1.6;
    }

    /* ── Layout ── */
    .profile-page {
        max-width: 1060px;
        margin: 48px auto;
        padding: 0 28px;
    }

    .page-grid {
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 24px;
        align-items: start;
    }

    @@media (max-width: 800px) {
        .page-grid { grid-template-columns: 1fr; }
        .profile-sidebar { order: -1; }
    }

    /* ── Profile Header ── */
    .profile-header {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        padding: 36px 40px;
        display: flex;
        align-items: flex-start;
        gap: 28px;
        margin-bottom: 20px;
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;
        background: #e8f0fe;
        border: 3px solid #e5e7eb;
    }

    .profile-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .profile-meta { flex: 1; min-width: 0; }

    .profile-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #111827;
        letter-spacing: -0.02em;
        margin-bottom: 3px;
    }

    .profile-handle {
        font-size: 0.9rem;
        color: #9ca3af;
        margin-bottom: 10px;
    }

    .profile-bio {
        font-size: 0.95rem;
        color: #6b7280;
        margin-bottom: 18px;
        max-width: 460px;
        line-height: 1.55;
    }

    /* Stats */
    .profile-stats {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
    }

    .stat { display: flex; flex-direction: column; }

    .stat-value {
        font-size: 1.2rem;
        font-weight: 700;
        color: #111827;
        line-height: 1;
    }

    .stat-label {
        font-size: 0.78rem;
        color: #9ca3af;
        margin-top: 3px;
        font-weight: 500;
    }

    .stat-divider {
        width: 1px;
        height: 30px;
        background: #e5e7eb;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 22px;
        border-radius: 10px;
        border: none;
        font-family: inherit;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s, opacity 0.15s, color 0.15s;
        min-width: 140px;
    }

    .btn:disabled:not(.btn-unfriend) { opacity: 0.55; cursor: default; }

    .btn-dark { background: #1f2937; color: #fff; }
    .btn-dark:hover:not(:disabled) { background: #374151; }

    .btn-muted { background: #f3f4f6; color: #9ca3af; border: 1px solid #e5e7eb; }

    .btn-blue { background: #1a56db; color: #fff; }
    .btn-blue:hover:not(:disabled) { background: #1648c0; }

    .btn-unfriend .unfriend-text { display: none; }
    .btn-unfriend:hover {
        background: #fee2e2 !important;
        color: #ef4444 !important;
        border: 1px solid #fca5a5 !important;
        cursor: pointer;
        opacity: 1 !important;
    }
    .btn-unfriend:hover .friends-text { display: none; }
    .btn-unfriend:hover .unfriend-text { display: inline; }

    /* Show More button */
    .show-more-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        padding: 11px 0;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        font-size: 0.88rem;
        font-weight: 600;
        color: #374151;
        cursor: pointer;
        margin-top: 4px;
        transition: background 0.15s, border-color 0.15s;
    }
    .show-more-btn:hover { background: #f9fafb; border-color: #d1d5db; }
    .show-more-btn .chevron { font-size: 0.75rem; transition: transform 0.2s; }
    .show-more-btn.expanded .chevron { transform: rotate(180deg); }

    /* ── Section header ── */
    .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
        margin-top: 4px;
    }

    .section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #374151;
        white-space: nowrap;
    }

    .section-line {
        flex: 1;
        height: 1px;
        background: #e5e7eb;
    }

    /* ── Event cards ── */
    .events-section { margin-bottom: 28px; }

    .event-card {
        display: flex;
        background: #fff;
        border-radius: 14px;
        border: 1px solid #e5e7eb;
        overflow: hidden;
        margin-bottom: 12px;
        text-decoration: none;
        color: inherit;
        transition: box-shadow 0.15s, border-color 0.15s;
    }

    .event-card:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        border-color: #d1d5db;
    }

    /* Hidden cards beyond page size */
    .event-card.hidden-card { display: none; }

    .event-card-img {
        width: 130px;
        flex-shrink: 0;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .event-card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* No image placeholder — matches homepage style */
    .event-card-img.no-img {
        color: #9ca3af;
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        min-height: 90px;
    }

    .event-card-body {
        padding: 18px 22px;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
    }

    .event-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 2px;
    }

    .event-info {
        font-size: 0.87rem;
        color: #9ca3af;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
    }

    .event-meta {
        display: flex;
        gap: 16px;
        font-size: 0.82rem;
        color: #6b7280;
        margin-top: 6px;
    }

    .event-meta span {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Empty state */
    .empty-state {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 40px 24px;
        text-align: center;
        color: #d1d5db;
        font-size: 0.9rem;
    }

    .empty-icon { font-size: 2rem; display: block; margin-bottom: 8px; opacity: 0.5; }

    /* ── Sidebar ── */
    .profile-sidebar { }

    .sidebar-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 24px 22px;
    }

    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        padding-bottom: 14px;
        border-bottom: 1px solid #f3f4f6;
    }

    .sidebar-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #374151;
    }

    .sidebar-count {
        font-size: 0.78rem;
        font-weight: 600;
        color: #9ca3af;
        background: #f3f4f6;
        padding: 2px 10px;
        border-radius: 99px;
    }

    .friend-list { display: flex; flex-direction: column; gap: 2px; }

    .friend-item {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: inherit;
        padding: 8px 8px;
        border-radius: 10px;
        transition: background 0.12s;
    }

    .friend-item:hover { background: #f9fafb; }

    .friend-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        background: #e8f0fe;
        border: 2px solid #f3f4f6;
    }

    .friend-name {
        font-size: 0.9rem;
        font-weight: 600;
        color: #111827;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .friend-handle {
        font-size: 0.77rem;
        color: #9ca3af;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .no-friends {
        font-size: 0.85rem;
        color: #d1d5db;
        text-align: center;
        padding: 16px 0;
        font-style: italic;
    }
</style>

<div class="profile-page">
    <div class="page-grid">

        <div>

            <div class="profile-header">
                <div class="profile-avatar">
                    <img src="@avatarUrl" alt="@username" />
                </div>

                <div class="profile-meta">
                    <div class="profile-name">@Model.FirstName @Model.LastName</div>
                    <div class="profile-handle">@@@Model.Username</div>

                    @if (!string.IsNullOrEmpty(Model.Bio))
                    {
                        <div class="profile-bio">@Model.Bio</div>
                    }

                    <div class="profile-stats">
                        <div class="stat">
                            <span class="stat-value">@hostedCount</span>
                            <span class="stat-label">Hosted</span>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat">
                            <span class="stat-value">@attendedCount</span>
                            <span class="stat-label">Attended</span>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat">
                            <span class="stat-value">@friends.Count</span>
                            <span class="stat-label">Friends</span>
                        </div>
                    </div>

                    @if (!isOwnProfile && currentUserId != 0)
                    {
                        var friendStatus = ViewData["FriendshipStatus"] as string ?? "None";
                        var friendRequesterId = ViewData["FriendshipRequesterId"] as int?;

                        if (friendStatus == "Accepted")
                        {
                            <button id="btnAddFriend" class="btn btn-muted btn-unfriend" data-user-id="@Model.Id" data-action="unfriend">
                                <span class="friends-text">Friends ✓</span>
                                <span class="unfriend-text">Unfriend</span>
                            </button>
                        }
                        else if (friendStatus == "Pending" && friendRequesterId == currentUserId)
                        {
                            <button id="btnAddFriend" class="btn btn-muted" data-user-id="@Model.Id" disabled>Request Sent</button>
                        }
                        else if (friendStatus == "Pending" && friendRequesterId == Model.Id)
                        {
                            <button id="btnAddFriend" class="btn btn-blue" data-user-id="@Model.Id" data-action="accept">Accept Request</button>
                        }
                        else
                        {
                            <button id="btnAddFriend" class="btn btn-dark" data-user-id="@Model.Id" data-action="add">Add Friend</button>
                        }
                    }
                </div>
            </div>

            @* ── Hosted Events ── *@
            <div class="events-section">
                <div class="section-header">
                    <span class="section-title">@firstName's Hosted Events</span>
                    <div class="section-line"></div>
                </div>

                @if (Model.CreatedEvents != null && Model.CreatedEvents.Any())
                {
                    var hostedList = Model.CreatedEvents.ToList();
                    for (int i = 0; i < hostedList.Count; i++)
                    {
                        var evt = hostedList[i];
                        var hasImg = !string.IsNullOrWhiteSpace(evt.PosterUrl);

                        // Parse description from Info field
                        var rawInfo = evt.Info ?? "";
                        var pipeIdx = rawInfo.IndexOf("| Description:");
                        var descText = pipeIdx >= 0
                            ? rawInfo.Substring(pipeIdx + "| Description:".Length).Trim()
                            : rawInfo.Trim();

                        <a href="/event/view/@evt.Id" class="event-card @(i >= PageSize ? "hidden-card" : "")" data-section="hosted">
                            @if (hasImg)
                            {
                                <div class="event-card-img">
                                    <img src="@evt.PosterUrl" alt="@evt.Title" />
                                </div>
                            }
                            else
                            {
                                <div class="event-card-img no-img">No Image</div>
                            }
                            <div class="event-card-body">
                                <div class="event-title">@evt.Title</div>
                                @if (!string.IsNullOrWhiteSpace(descText))
                                {
                                    <div class="event-info">@descText</div>
                                }
                                <div class="event-meta">
                                    <span>📅 @(evt.StartAt?.ToString("dd MMM yyyy") ?? "TBA")</span>
                                    <span>📍 @evt.Location</span>
                                </div>
                            </div>
                        </a>
                    }

                    @if (hostedList.Count > PageSize)
                    {
                        <button class="show-more-btn" data-section="hosted" data-total="@hostedList.Count" data-shown="@PageSize">
                            Show @(hostedList.Count - PageSize) more events <span class="chevron">▼</span>
                        </button>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <span class="empty-icon">📋</span>
                        No events hosted yet
                    </div>
                }
            </div>

            @* ── Joined Events ── *@
            <div class="events-section">
                <div class="section-header">
                    <span class="section-title">Events @firstName Joined</span>
                    <div class="section-line"></div>
                </div>

                @if (joinedEvents.Any())
                {
                    for (int i = 0; i < joinedEvents.Count; i++)
                    {
                        var evt = joinedEvents[i];
                        var hasImg = !string.IsNullOrWhiteSpace(evt.PosterUrl);

                        var rawInfo = evt.Info ?? "";
                        var pipeIdx = rawInfo.IndexOf("| Description:");
                        var descText = pipeIdx >= 0
                            ? rawInfo.Substring(pipeIdx + "| Description:".Length).Trim()
                            : rawInfo.Trim();

                        <a href="/event/view/@evt.Id" class="event-card @(i >= PageSize ? "hidden-card" : "")" data-section="joined">
                            @if (hasImg)
                            {
                                <div class="event-card-img">
                                    <img src="@evt.PosterUrl" alt="@evt.Title" />
                                </div>
                            }
                            else
                            {
                                <div class="event-card-img no-img">No Image</div>
                            }
                            <div class="event-card-body">
                                <div class="event-title">@evt.Title</div>
                                @if (!string.IsNullOrWhiteSpace(descText))
                                {
                                    <div class="event-info">@descText</div>
                                }
                                <div class="event-meta">
                                    <span>📅 @(evt.StartAt?.ToString("dd MMM yyyy") ?? "TBA")</span>
                                    <span>📍 @evt.Location</span>
                                </div>
                            </div>
                        </a>
                    }

                    @if (joinedEvents.Count > PageSize)
                    {
                        <button class="show-more-btn" data-section="joined" data-total="@joinedEvents.Count" data-shown="@PageSize">
                            Show @(joinedEvents.Count - PageSize) more events <span class="chevron">▼</span>
                        </button>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <span class="empty-icon">🗓</span>
                        Hasn't joined any events yet
                    </div>
                }
            </div>

        </div>

        <aside class="profile-sidebar">
            <div class="sidebar-card">
                <div class="sidebar-header">
                    <span class="sidebar-title">@firstName's Friends</span>
                    <span class="sidebar-count">@friends.Count</span>
                </div>

                <div class="friend-list">
                    @if (friends.Any())
                    {
                        foreach (var friend in friends)
                        {
                            var fAvatar = string.IsNullOrEmpty(friend.ProfilePictureUrl)
                                ? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(friend.Username)}&background=e8f0fe&color=1a56db"
                                : friend.ProfilePictureUrl;

                            <a href="/user/@friend.Username" class="friend-item">
                                <img src="@fAvatar" class="friend-avatar" alt="@friend.Username" />
                                <div style="min-width:0;">
                                    <div class="friend-name">@friend.FirstName @friend.LastName</div>
                                    <div class="friend-handle">@@@friend.Username</div>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="no-friends">No friends yet</p>
                    }
                </div>
            </div>
        </aside>

    </div>
</div>

@section Scripts {
<script>
    // ── Show More / Show Less ──
    document.querySelectorAll('.show-more-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const section = this.dataset.section;
            const total = parseInt(this.dataset.total);
            const cards = document.querySelectorAll(`.event-card[data-section="${section}"]`);
            const isExpanded = this.classList.contains('expanded');

            if (isExpanded) {
                // Collapse back to 5
                cards.forEach((card, i) => {
                    if (i >= @PageSize) card.classList.add('hidden-card');
                });
                this.classList.remove('expanded');
                this.innerHTML = `Show ${total - @PageSize} more events <span class="chevron">▼</span>`;
            } else {
                // Show all
                cards.forEach(card => card.classList.remove('hidden-card'));
                this.classList.add('expanded');
                this.innerHTML = `Show less <span class="chevron">▼</span>`;
            }
        });
    });

    // ── Friend button ──
    const btn = document.getElementById('btnAddFriend');
    if (btn) {
        btn.addEventListener('click', async function () {
            const targetId = btn.dataset.userId;
            const action = btn.dataset.action;

            btn.disabled = true;
            if (action === 'accept') btn.innerText = 'Accepting...';
            else if (action === 'unfriend') btn.innerText = 'Removing...';
            else btn.innerText = 'Sending...';

            try {
                let res;
                if (action === 'accept') {
                    res = await fetch(`/user/friends/${targetId}/accept`, { method: 'PATCH' });
                } else if (action === 'unfriend') {
                    res = await fetch(`/user/friends/${targetId}`, { method: 'DELETE' });
                } else {
                    res = await fetch(`/user/friends/${targetId}`, { method: 'POST' });
                }

                if (res.ok) {
                    if (action === 'unfriend') {
                        btn.innerText = 'Add Friend';
                        btn.className = 'btn btn-dark';
                        btn.dataset.action = 'add';
                        btn.disabled = false;
                    } else if (action === 'accept') {
                        btn.innerHTML = '<span class="friends-text">Friends ✓</span><span class="unfriend-text">Unfriend</span>';
                        btn.className = 'btn btn-muted btn-unfriend';
                        btn.dataset.action = 'unfriend';
                        btn.disabled = false;
                    } else {
                        btn.innerText = 'Request Sent';
                        btn.className = 'btn btn-muted';
                        btn.disabled = true;
                    }
                    window.location.reload();
                } else if (res.status === 401) {
                    window.location.href = '/Login';
                } else {
                    btn.disabled = false;
                    resetBtnText(btn, action);
                    alert('Something went wrong.');
                }
            } catch {
                btn.disabled = false;
                resetBtnText(btn, action);
                alert('Network error.');
            }
        });
    }

    function resetBtnText(button, action) {
        if (action === 'accept') button.innerText = 'Accept Request';
        else if (action === 'unfriend') {
            button.innerHTML = '<span class="friends-text">Friends ✓</span><span class="unfriend-text">Unfriend</span>';
        }
        else button.innerText = 'Add Friend';
    }
</script>
}
