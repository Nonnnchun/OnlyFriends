@model OnlyFriends.Models.DTOS.UserDTOS.UpdateUserDTO

@{
    ViewData["Title"] = "Settings";
}

<style>
    body {
        font-family: "Inter", sans-serif;
        background-color: #fafafa;
        margin: 0;
        padding: 0;
    }

    .settings-container {
        width: 90%;
        max-width: 900px;
        margin: 40px auto;
        padding-bottom: 40px;
    }

    .page-title {
        font-size: 36px;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .section-title {
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 5px;
        margin-top: 15px;
    }

    .section-sub {
        color: #777;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .section-box {
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #eee;
        margin-bottom: 30px;
    }

    /* Minimal Profile Picture Styles */
    .pfp-upload-container {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 1px solid #f5f5f5;
    }

    .pfp-preview-circle {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        border: 1px solid #ddd;
        overflow: hidden;
        background: #f9f9f9;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pfp-preview-circle img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .pfp-controls label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .custom-file-upload {
        display: inline-block;
        padding: 8px 16px;
        cursor: pointer;
        background: #f0f0f0;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        transition: 0.2s;
    }

    .custom-file-upload:hover {
        background: #e5e5e5;
    }

    /* Form Grid */
    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        margin-top: 20px;
    }

    .form-label {
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 8px;
        display: block;
    }

    input, select, textarea {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 14px;
        box-sizing: border-box;
        font-family: inherit;
        font-family: "Inter", sans-serif;
    }

    input:focus, textarea:focus {
        outline: none;
        border-color: #000;
    }

    textarea {
        resize: vertical;
        min-height: 100px;
    }

    .save-btn {
        margin-top: 20px;
        padding: 10px 22px;
        border-radius: 999px;
        border: none;
        background: #111;
        color: white;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        transition: background 0.2s ease;
    }

    .save-btn:hover {
        background: #333;
    }

    .danger-btn {
        background: #fff;
        color: #e53935;
        border: 1px solid #e53935;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
    }

    .danger-btn:hover {
        background: #fff5f5;
    }

    .item-box {
        background: #f9f9f9;
        border-radius: 10px;
        padding: 15px;
        border: 1px solid #eee;
        margin-bottom: 15px;
    }

    .danger-btn {
        background: #e53935;
        color: #fff;
        padding: 12px 20px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        font-weight: 500;
        transition: background 0.2s ease;
    }

    .danger-btn:hover {
        background: #c62828;
    }
</style>

<div class="settings-container">
    <div class="page-title">Settings</div>

    @* Use multipart/form-data for image uploads *@
    <form asp-action="UpdateProfile" asp-controller="Setting" method="post" enctype="multipart/form-data">
        @* Hidden ID field ensures we update the correct user *@
        <input type="hidden" asp-for="Id" />

        <div class="section-title">Your Profile</div>
        <div class="section-sub">Choose how you are displayed as a host or guest.</div>
        
        <div class="section-box">
            <div class="pfp-upload-container">
                <div class="pfp-preview-circle">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img id="pfp-preview" src="@Model.ProfilePictureUrl" alt="Profile" />
                    }
                    else
                    {
                        <img id="pfp-preview" src="/images/default-avatar.png" alt="Default Profile" />
                    }
                </div>
                <div class="pfp-controls">
                    <label>Profile Picture</label>
                    <label for="pfp-input" class="custom-file-upload">
                        Change Photo
                    </label>
                    <input type="file" id="pfp-input" asp-for="ProfilePicture" accept="image/*" style="display: none;" />
                </div>
            </div>

            <div class="form-group">
            <div class="grid-2">
                <div>
                    <label class="form-label">First Name</label>
                    <input type="text" asp-for="FirstName" placeholder="John">
                </div>
                <div>
                    <label class="form-label">Last Name</label>
                    <input type="text" asp-for="LastName" placeholder="Doe">
                </div>
            </div>

            <div style="margin-top:20px;">
                <label class="form-label">Username</label>
                <input type="text" asp-for="Username" placeholder="username">
            </div>

            <div style="margin-top:20px;">
                <label class="form-label">Bio</label>
                <textarea asp-for="Bio" placeholder="Write something about yourself..."></textarea>
            </div>

            <button type="submit" class="save-btn">Save Changes</button>
        </div>
    </form>

    <div class="section-title">Account Security</div>
    <div class="section-box">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div style="font-weight: 600;">Password</div>
                <div style="font-size: 13px; color: #777;">Last changed 3 months ago</div>
            </div>
            <button class="custom-file-upload">Update</button>
        </div>
    </div>

    <div class="section-title" style="color: #e53935;">Danger Zone</div>
    <div class="section-box" style="border-color: #ffcdd2;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="font-size: 14px; color: #777;">Permanently delete your account and all data.</div>
            <button class="danger-btn">Delete Account</button>
        </div>
    </div>
</div>

<script>
    // Preview the image immediately after choosing a file
    document.getElementById('pfp-input').onchange = function (evt) {
        var tgt = evt.target || window.event.srcElement,
            files = tgt.files;

        if (FileReader && files && files.length) {
            var fr = new FileReader();
            fr.onload = function () {
                document.getElementById('pfp-preview').src = fr.result;
            }
            fr.readAsDataURL(files[0]);
        }
    }
</script>
