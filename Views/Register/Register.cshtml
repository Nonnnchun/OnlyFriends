

@model OnlyFriends.Models.DTOS.UserDTOS.CreateUserDTO;

@section Scripts {
    <script src="~/js/hide-password.js" asp-append-version="true"></script>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm p-4">
                <div class="card-body">
                    <h2 class="text-center fw-bold mb-4">Create Account</h2>
                    <p class="text-muted text-center mb-4">Join our community today.</p>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label small fw-semibold"></label>
                            <input asp-for="Username" class="form-control form-control-lg bg-light border-0"
                                   placeholder="johndoe" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label small fw-semibold"></label>
                                <input asp-for="FirstName" class="form-control bg-light border-0" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label small fw-semibold"></label>
                                <input asp-for="LastName" class="form-control bg-light border-0" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold"></label>
                            <input asp-for="Email" class="form-control bg-light border-0"
                                   placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label small fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Password" id="passwordField" class="form-control bg-light border-0" />
                                <button class="btn btn-light border-0 bg-light" type="button" id="togglePassword">
                                    <span id="toggleIcon">👁️</span>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-dark btn-lg w-100 shadow-sm">Register</button>
                    </form>

                    <div class="text-center mt-4">
                        <span class="text-muted small">Already have an account?</span>
                        <a asp-controller="Login" asp-action="Index" class="text-decoration-none small fw-bold text-dark">Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .form-control:focus {
        background-color: #fff !important;
        border: 1px solid #000 !important;
        box-shadow: none;
    }

    .btn-dark:hover {
        background-color: #333;
    }
</style>