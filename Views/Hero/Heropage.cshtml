@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/Views/Hero/Heropage.cshtml.css" asp-append-version="true" />
}

<section class="landing-wrapper">
    <main class="hero-section">
        <div class="hero-content">
            <div class="brand-logo" style="display:none;">
                <strong>OnlyFriends</strong>
            </div>

            <h1 class="hero-title">
                Looking for new friends?<br />
                Start here <br />
                <span class="text-gradient">Start here</span>
            </h1>

            <p class="hero-subtitle">
                Start activities you love and invite new friends to join.
            </p>

            <button class="of-btn of-btn-primary" id="heroCreateBtn">Create your first activity</button>
        </div>

        <div class="hero-image-container">
            <img src="https://i.ibb.co/bR8KPymn/OIG3-5-AXItu-Z-KQ776k-FBJAb.jpg" alt="Event App Preview" class="hero-image" />
        </div>
    </main>

    <section class="hero-highlights">
        <h2>Why people use OnlyFriends</h2>
        <div class="highlight-grid">
            <article class="highlight-card">
                <div class="highlight-icon"><i class="fa-solid fa-calendar-plus"></i></div>
                <h3>Create Events Easily</h3>
                <p>Set title, location, time, and categories in minutes.</p>
            </article>
            <article class="highlight-card">
                <div class="highlight-icon"><i class="fa-solid fa-user-group"></i></div>
                <h3>Invite Your Friends</h3>
                <p>Send invites and keep all responses in one place.</p>
            </article>
            <article class="highlight-card">
                <div class="highlight-icon"><i class="fa-solid fa-list-check"></i></div>
                <h3>Manage Requests</h3>
                <p>Approve, reject, and organize participants smoothly.</p>
            </article>
        </div>
    </section>

    <section class="hero-steps">
        <h2>How it works</h2>
        <div class="steps-grid">
            <article class="step-card">
                <span class="step-no">01</span>
                <h3>Create</h3>
                <p>Start an activity with your preferred date, place, and format.</p>
            </article>
            <article class="step-card">
                <span class="step-no">02</span>
                <h3>Invite</h3>
                <p>Share with friends and open your event to new connections.</p>
            </article>
            <article class="step-card">
                <span class="step-no">03</span>
                <h3>Join</h3>
                <p>Participants join, hosts manage requests, everyone meets up.</p>
            </article>
        </div>
    </section>
</section>

<div id="heroLoginPrompt" class="hero-modal-backdrop is-hidden">
    <div class="hero-modal">
        <h2 class="hero-modal-title" id="heroLoginPromptTitle">Sign-in required</h2>
        <p class="hero-modal-text" id="heroLoginPromptText">
            Please sign in to create a new activity.
        </p>
        <div class="hero-modal-actions">
            <button class="of-btn of-btn-neutral" id="heroModalClose">Close</button>
            <button class="of-btn of-btn-primary" id="heroGoLogin">Go to Login</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function heroIsAuthenticated() {
            try {
                const res = await fetch('/api/auth/me', { cache: 'no-store', credentials: 'include' });
                return res.ok;
            } catch {
                return false;
            }
        }

        (function () {
            const createBtn = document.getElementById('heroCreateBtn');
            const modal = document.getElementById('heroLoginPrompt');
            const modalTitle = document.getElementById('heroLoginPromptTitle');
            const modalText = document.getElementById('heroLoginPromptText');
            const closeBtn = document.getElementById('heroModalClose');
            const goLoginBtn = document.getElementById('heroGoLogin');
            if (!createBtn) return;

            window.showHeroLoginPrompt = function (context) {
                if (modalTitle) {
                    modalTitle.textContent = 'Sign-in required';
                }

                if (modalText) {
                    if (context === 'settings') {
                        modalText.textContent = 'Please sign in to access Settings.';
                    } else {
                        modalText.textContent = 'Please sign in to create a new activity.';
                    }
                }

                if (modal) {
                    modal.classList.remove('is-hidden');
                }
            };

            function openModal() {
                if (typeof window.showHeroLoginPrompt === 'function') {
                    window.showHeroLoginPrompt('create');
                }
            }
            function closeModal() {
                if (modal) {
                    modal.classList.add('is-hidden');
                }
            }

            createBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const authed = await heroIsAuthenticated();
                if (authed) {
                    window.location.href = '@Url.Action("Create", "Event")';
                    return;
                }
                openModal();
            });

            if (closeBtn) {
                closeBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    closeModal();
                });
            }

            if (goLoginBtn) {
                goLoginBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    window.location.href = '@Url.Action("Index", "Login")';
                });
            }

            window.addEventListener('click', function (e) {
                if (e.target === modal) {
                    closeModal();
                }
            });
        })();
    </script>
}
