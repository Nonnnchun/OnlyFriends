@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>หน้าแรก - OnlyFriends</title>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlyFriends.styles.css" asp-append-version="true" />
</head>
<body>

    <div class="landing-wrapper">
        <nav class="landing-nav">
            <div class="nav-left">
                <a href="/Home/Homepage" class="landing-brand">OnlyFriends</a>
            </div>
            <div class="nav-right">
                <span class="live-time" id="clock"></span>
                <button class="btn-login" onclick="window.location.href='@Url.Action("Index", "Login")'">เข้าสู่ระบบ</button>
            </div>
        </nav>

        <main class="hero-section">
            <div class="hero-content">
                <div class="brand-logo">
                    <strong>OnlyFriends</strong>
                </div>
                
                <h1 class="hero-title">
                    ต้องการหาเพื่อน<br />
                    เริ่มต้นที่นี่ <br />
                    <span class="text-gradient">เริ่มต้นที่นี่</span>
                </h1>
                
                <p class="hero-subtitle">
                    เริ่มต้นกิจกรรมที่คุณสนใจ ชวนเพื่อนใหม่มาร่วมจอย
                </p>
                
                <button class="btn-primary" onclick="window.location.href='@Url.Action("CreateActivity", "Home")'">
                    สร้างกิจกรรมแรกของคุณ
                </button>
            </div>

            <div class="hero-image-container">
                <img src="https://i.ibb.co/bR8KPymn/OIG3-5-AXItu-Z-KQ776k-FBJAb.jpg" alt="Event App Preview" class="hero-image" />
            </div>
        </main>
    </div>

    <script>
        function updateClock() {
            const now = new Date();
            const hours = now.getHours().toString().padStart(2, '0');
            const minutes = now.getMinutes().toString().padStart(2, '0');
            document.getElementById('clock').innerText = `${hours} นาฬิกา ${minutes} นาที GMT+7`;
        }
        setInterval(updateClock, 1000);
        updateClock(); 
    </script>
</body>
</html>